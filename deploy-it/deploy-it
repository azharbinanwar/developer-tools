#!/usr/bin/env bash
# deploy-it — make-a-build's terminal presentation, with Vercel operations.
set -uo pipefail
# ── looks ─────────────────────────────────────────────────────────────────
if [ -t 2 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  B=$(tput bold); D=$(tput dim); R=$(tput sgr0)
  A=$(tput setaf 6); G=$(tput setaf 2); Y=$(tput setaf 3); E=$(tput setaf 1)
else B=; D=; R=; A=; G=; Y=; E=; fi
VERSION="1.0.0"
RULE="────────────────────────────────────────────"
banner(){ printf "\n  ${A}${B}◆  %s${R}  ${D}%s${R}\n" "$1" "${2:-}" >&2; }
step(){ printf "\n  ${A}${B}▸${R} ${B}%s${R}\n" "$1" >&2; }
sub(){ printf "     ${D}%s${R}\n" "$1" >&2; }
ok(){ printf "     ${G}✓${R} %s\n" "$1" >&2; }
warn(){ printf "     ${Y}!${R} %s\n" "$1" >&2; }
die(){ printf "\n  ${E}${B}✗ %s${R}\n" "$1" >&2; exit 1; }
row(){ printf "     ${D}%-11s${R} %s\n" "$1" "$2" >&2; }
have(){ command -v "$1" >/dev/null 2>&1; }


# ── menus and prompts ─────────────────────────────────────────────────────
MENU_ITEMS=(); MENU_NOTES=()
menu_pick(){ if [ -t 0 ]; then menu_arrows "$@"; else menu_numbers "$@"; fi; }
menu_arrows(){ # $1 title  $2 skip index (-1 for none)  $3 index to start on -> echoes chosen index
  local title="$1" skip="$2"
  local n=${#MENU_ITEMS[@]} sel="$3" k rest i saved
  saved="$(stty -g 2>/dev/null || true)"
  [ -n "$saved" ] && { stty -echo -icanon 2>/dev/null || true
                       trap 'stty "$saved" 2>/dev/null; exit 130' INT; }
  printf "     ${D}%s${R}  ${D}· ↑↓ move · Enter picks%s${R}\n" \
    "$title" "$([ "$skip" -ge 0 ] && echo " · q skips")" >&2
  for ((i=0;i<n;i++)); do printf '\n' >&2; done
  while :; do
    printf "\033[%dA" "$n" >&2
    for i in $(seq 0 $((n-1))); do
      if [ "$i" -eq "$sel" ]; then printf "\r\033[K     ${A}❯ %s${R}%s\n" "${MENU_ITEMS[$i]}" "${MENU_NOTES[$i]}" >&2
      else                         printf "\r\033[K       ${D}%s${R}%s\n" "${MENU_ITEMS[$i]}" "${MENU_NOTES[$i]}" >&2; fi
    done
    IFS= read -rsn1 k 2>/dev/null || break
    case "$k" in
      '')      break ;;
      $'\e')   IFS= read -rsn2 rest 2>/dev/null || rest=""  # bash 3.2 has no sub-second read -t
               case "$rest" in "[A") sel=$(((sel-1+n)%n)) ;; "[B") sel=$(((sel+1)%n)) ;; esac ;;
      k|K|w|W) sel=$(((sel-1+n)%n)) ;;
      j|J|s|S) sel=$(((sel+1)%n)) ;;
      q|Q)     [ "$skip" -ge 0 ] && { sel="$skip"; break; } ;;
    esac
  done
  [ -n "$saved" ] && { trap - INT; stty "$saved" 2>/dev/null || true; }
  printf '%s' "$sel"
}
menu_numbers(){ # same contract, for when stdin is not a terminal
  local title="$1" skip="$2" start="$3"
  local n=${#MENU_ITEMS[@]} i r def=$((start+1))
  printf "     ${D}%s:${R}\n" "$title" >&2
  for i in $(seq 0 $((n-1))); do
    printf "       ${A}%d)${R} %s%s\n" "$((i+1))" "${MENU_ITEMS[$i]}" "${MENU_NOTES[$i]}" >&2
  done
  while :; do
    printf "     ${A}Pick${R} ${D}[%s]${R} ${A}›${R} " "$def" >&2
    read -r r || { [ "$skip" -ge 0 ] && printf '%s' "$skip" || printf '%s' "$start"; return 0; }  # EOF: back out, never spin
    [ -n "$r" ] || r="$def"
    case "$r" in *[!0-9]*|'') continue ;; esac
    [ "$r" -ge 1 ] && [ "$r" -le "$n" ] && { printf '%s' "$((r-1))"; return 0; }
  done
}
ask(){ # $1 label  $2 default -> prints default if the user just hits Enter
  local r; printf "     ${A}%s${R} ${D}[%s]${R} ${A}›${R} " "$1" "${2:-none}" >&2
  read -r r || exit 130; printf '%s' "${r:-$2}"; }
ask_secret(){ local r; printf "     ${A}%s${R} ${D}[%s]${R} ${A}›${R} " "$1" "${2:-none}" >&2
  stty -echo 2>/dev/null; read -r r; stty echo 2>/dev/null; printf '\n' >&2
  printf '%s' "${r:-$2}"; }
ask_yn(){ local r d; [ "$2" = true ] && d="yes" || d="no"
  printf "     ${A}%s${R} ${D}(y/n) [%s]${R} ${A}›${R} " "$1" "$d" >&2
  read -r r; case "$r" in [yY]*) echo true ;; [nN]*) echo false ;; *) echo "$2" ;; esac; }


if [ "${1:-}" = "--menu-bridge" ]; then
  title="$2"; shift 2
  MENU_ITEMS=("$@" "← back")
  MENU_NOTES=()
  for ((i=0; i<${#MENU_ITEMS[@]}; i++)); do MENU_NOTES+=(""); done
  menu_pick "$title" $(( ${#MENU_ITEMS[@]} - 1 )) "${DEPLOY_IT_MENU_DEFAULT:-0}"
  exit 0
fi
if [ "${1:-}" = "--prompt-bridge" ]; then
  ask "$2" "${3:-}"
  exit 0
fi

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  case "$script_path" in /*) ;; *) script_path="$script_dir/$script_path" ;; esac
done
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
case "${1:-}" in --help|-h|--version) ;; *) banner "deploy-it $VERSION" "build it, publish it, manage it" ;; esac
exec python3 "$script_dir/main.py" "$@"
