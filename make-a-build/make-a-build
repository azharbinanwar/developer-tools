config_menu(){
  local idx
  while :; do
    MENU_ITEMS=("apps and email lists" "mail account" "mail template"
                "appho.st accounts" "appho.st credentials" "open config.json" "← back")
    MENU_NOTES=("  ${D}$(cfg projects | grep -c . | tr -d ' ') saved${R}"
                "  ${D}$([ "$(cfg smtp_ready)" = yes ] && echo "$(cfg smtp_get user)" || echo 'not set up yet')${R}"
                "  ${D}subject and body${R}"
                "  ${D}$(cfg count) total · switch or add${R}"
                "  ${D}user_id and API key for “$(cfg current)”${R}"
                "  ${D}$CONFIG${R}" "")
    step "Settings"
    idx="$(menu_pick "What to change" 6 0)"
    case "$idx" in
