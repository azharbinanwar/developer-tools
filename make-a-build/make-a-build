#!/usr/bin/env bash
# make-a-build: build it, ship it to appho.st, mail the link.
#
# Everything lives in this one folder — the script, the config, the send logs —
# so it can be zipped and handed to someone else in one piece. Nothing is
# written into your project repos, so no email address can ever be committed.
#
# Zero dependencies beyond macOS built-ins (curl, python3, pbcopy) plus fvm/flutter
# when you ask it to build. qrencode is used if present and skipped if not.
#
# License: MIT.

set -uo pipefail

# ── looks ─────────────────────────────────────────────────────────────────
if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  B=$(tput bold); D=$(tput dim); R=$(tput sgr0)
  A=$(tput setaf 6); G=$(tput setaf 2); Y=$(tput setaf 3); E=$(tput setaf 1)
else B=; D=; R=; A=; G=; Y=; E=; fi
VERSION="1.0.0"
RULE="────────────────────────────────────────────"
banner(){ printf "\n  ${A}${B}◆  %s${R}  ${D}%s${R}\n" "$1" "${2:-}" >&2; }
step(){ printf "\n  ${A}${B}▸${R} ${B}%s${R}\n" "$1" >&2; }
sub(){ printf "     ${D}%s${R}\n" "$1" >&2; }
ok(){ printf "     ${G}✓${R} %s\n" "$1" >&2; }
warn(){ printf "     ${Y}!${R} %s\n" "$1" >&2; }
die(){ printf "\n  ${E}${B}✗ %s${R}\n" "$1" >&2; exit 1; }
row(){ printf "     ${D}%-11s${R} %s\n" "$1" "$2" >&2; }
have(){ command -v "$1" >/dev/null 2>&1; }

# resolve through the PATH symlink so config and logs stay in the real folder
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
HOME_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
CONFIG="$HOME_DIR/config.json"
LOGS="$HOME_DIR/logs"
LEGACY="$HOME/.apphost"
API="https://appho.st/api"
MAX_APKS=25
MAX_MB=100          # appho.st free tier rejects builds bigger than this

have python3 || die "python3 is required (it ships with macOS developer tools)."
mkdir -p "$LOGS"

# ── config ────────────────────────────────────────────────────────────────
# One python block owns the file; bash only ever asks it for lines.
cfg(){
python3 - "$CONFIG" "$LEGACY" "$@" <<'PY'
import json, os, re, sys

path, legacy, op = sys.argv[1], sys.argv[2], sys.argv[3]
a = sys.argv[4:]

ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")

def clean(v):
    """Terminal escapes once leaked into captured values; never store them."""
    return ANSI.sub("", v).strip() if isinstance(v, str) else v

try:
    d = json.load(open(path))
except Exception:
    d = {}

a = [clean(x) for x in a]

# first run: adopt the accounts the old Desktop script already set up
if not d and os.path.exists(legacy):
    try:
        old = json.load(open(legacy))
        if "accounts" in old:
            d = {"current": old.get("current", "default"), "accounts": old["accounts"]}
        else:
            d = {"current": "default", "accounts": {"default": {
                "user_id": old.get("user_id", ""), "key": old.get("key", ""),
                "apps": old.get("apps", {})}}}
    except Exception:
        d = {}

accts = d.setdefault("accounts", {})
if not accts:
    accts["default"] = {"user_id": "", "key": "", "apps": {}}
if d.get("current") not in accts:
    d["current"] = sorted(accts)[0]
cur = accts[d["current"]]
cur.setdefault("apps", {})

d.setdefault("smtp", {"host": "", "port": 465, "user": "", "password": "",
                      "from_name": "", "reply_to": "", "bcc": []})
d.setdefault("projects", {})
for _p in d["projects"].values():
    if "recipients" in _p: _p.setdefault("to", _p.pop("recipients"))
    if "team" in _p: _p.setdefault("bcc", _p.pop("team"))
d.setdefault("template", {
    "subject": "{app} {version} — new test build",
    "body": ("Hi {name},\n\n"
             "A new build of {app} is ready to install.\n\n"
             "    {link}\n\n"
             "Version {version}{notes}\n\n"
             "Open the link on the device you want to install it on.\n\n"
             "— {sender}"),
})

def save():
    with open(path, "w") as f:
        json.dump(d, f, indent=2)
    os.chmod(path, 0o600)          # it holds API keys and a mail password

# first run writes the file straight away, so the folder is self-contained
# from the very first command rather than only after the first edit
if not os.path.exists(path):
    save()

def owner(p):
    """The project's own account; failing that, whichever account lists its app id."""
    n = p.get("account", "")
    if n in accts:
        return n
    return next((k for k in sorted(accts) if p.get("app_id") and p["app_id"] in accts[k].get("apps", {}).values()), "")

def proj(key):
    return d["projects"].setdefault(key, {"path": "", "app": "", "app_id": "", "account": "", "to": []})

if op == "current":   print(d["current"])
elif op == "count":   print(len(accts))
elif op == "get":     print(cur.get(a[0], ""))
elif op == "set":     cur[a[0]] = a[1]; save()
elif op == "accounts":
    for n in sorted(accts):
        print("%s\t%s\t%d" % (n, accts[n].get("user_id") or "no credentials yet", len(accts[n].get("apps", {}))))
elif op == "acct_get":  print(accts.get(a[0], {}).get(a[1], ""))
elif op == "proj_acct":
    # the project's own account; failing that, whichever account lists its app id
    p = proj(a[0])
    n = owner(p)
    if n and p.get("account") != n: p["account"] = n; save()
    print(n)
elif op == "switch":
    if a[0] in accts: d["current"] = a[0]; save()
elif op == "acct_add":
    accts.setdefault(a[0], {"user_id": "", "key": "", "apps": {}}); d["current"] = a[0]; save()
elif op == "acct_del":
    if len(accts) > 1 and a[0] in accts:
        del accts[a[0]]
        if d["current"] == a[0]: d["current"] = sorted(accts)[0]
        save()
    else:
        sys.exit(1)
elif op == "acct_ren":
    if a[0] in accts and a[1]:
        accts[a[1]] = accts.pop(a[0])
        if d["current"] == a[0]: d["current"] = a[1]
        save()
elif op == "apps":
    for k, v in sorted(cur["apps"].items()): print(k + "\t" + v)
elif op == "app_set":
    if len(a) > 2 and a[2]: cur["apps"].pop(a[2], None)
    cur["apps"][a[0]] = a[1]; save()
elif op == "app_del":
    cur["apps"].pop(a[0], None); save()

# ── smtp ──
elif op == "smtp_get":  print(d["smtp"].get(a[0], ""))
elif op == "smtp_set":  d["smtp"][a[0]] = a[1]; save()
elif op == "smtp_ready":
    s = d["smtp"]
    print("yes" if s.get("host") and s.get("user") and s.get("password") else "no")
elif op == "bcc":
    for e in d["smtp"].get("bcc", []): print(e)
elif op == "bcc_add":
    if a[0] and a[0] not in d["smtp"]["bcc"]: d["smtp"]["bcc"].append(a[0]); save()
elif op == "bcc_del":
    d["smtp"]["bcc"] = [e for e in d["smtp"]["bcc"] if e != a[0]]; save()

# ── projects ──
elif op == "projects":
    for k in sorted(d["projects"]):
        p = d["projects"][k]
        print("%s\t%s\t%s\t%s\t%d\t%s" % (k, p.get("path", ""), p.get("app", ""), p.get("app_id", ""), len(p.get("to", [])), owner(p)))
elif op == "proj_get":   print(proj(a[0]).get(a[1], ""))
elif op == "proj_set":   proj(a[0])[a[1]] = a[2]; save()
elif op == "proj_del":   d["projects"].pop(a[0], None); save()
elif op == "people":          # key [to|cc|bcc]
    for r in proj(a[0]).get(a[1] if len(a) > 1 else "to", []):
        print("%s\t%s" % (r.get("name", ""), r.get("email", "")))
elif op == "person_add":      # key name email [to|cc|bcc]
    p = proj(a[0]); f = a[3] if len(a) > 3 else "to"
    p[f] = [r for r in p.get(f, []) if r.get("email") != a[2]]
    p[f].append({"name": a[1], "email": a[2]}); save()
elif op == "person_del":      # key email [to|cc|bcc]
    p = proj(a[0]); f = a[2] if len(a) > 2 else "to"
    p[f] = [r for r in p.get(f, []) if r.get("email") != a[1]]; save()

# ── template ──
elif op == "tpl_get": print(d["template"].get(a[0], ""))
elif op == "tpl_set": d["template"][a[0]] = a[1]; save()
else: sys.exit(2)
PY
}

# ── menus and prompts ─────────────────────────────────────────────────────
MENU_ITEMS=(); MENU_NOTES=()
menu_pick(){ if [ -t 0 ]; then menu_arrows "$@"; else menu_numbers "$@"; fi; }
menu_arrows(){ # $1 title  $2 skip index (-1 for none)  $3 index to start on -> echoes chosen index
  local title="$1" skip="$2"
  local n=${#MENU_ITEMS[@]} sel="$3" k rest i saved
  saved="$(stty -g 2>/dev/null || true)"
  [ -n "$saved" ] && { stty -echo -icanon 2>/dev/null || true
                       trap 'stty "$saved" 2>/dev/null; exit 130' INT; }
  printf "     ${D}%s${R}  ${D}· ↑↓ move · Enter picks%s${R}\n" \
    "$title" "$([ "$skip" -ge 0 ] && echo " · q skips")" >&2
  for ((i=0;i<n;i++)); do printf '\n' >&2; done
  while :; do
    printf "\033[%dA" "$n" >&2
    for i in $(seq 0 $((n-1))); do
      if [ "$i" -eq "$sel" ]; then printf "\r\033[K     ${A}❯ %s${R}%s\n" "${MENU_ITEMS[$i]}" "${MENU_NOTES[$i]}" >&2
      else                         printf "\r\033[K       ${D}%s${R}%s\n" "${MENU_ITEMS[$i]}" "${MENU_NOTES[$i]}" >&2; fi
    done
    IFS= read -rsn1 k 2>/dev/null || break
    case "$k" in
      '')      break ;;
      $'\e')   IFS= read -rsn2 rest 2>/dev/null || rest=""  # bash 3.2 has no sub-second read -t
               case "$rest" in "[A") sel=$(((sel-1+n)%n)) ;; "[B") sel=$(((sel+1)%n)) ;; esac ;;
      k|K|w|W) sel=$(((sel-1+n)%n)) ;;
      j|J|s|S) sel=$(((sel+1)%n)) ;;
      q|Q)     [ "$skip" -ge 0 ] && { sel="$skip"; break; } ;;
    esac
  done
  [ -n "$saved" ] && { trap - INT; stty "$saved" 2>/dev/null || true; }
  printf '%s' "$sel"
}
menu_numbers(){ # same contract, for when stdin is not a terminal
  local title="$1" skip="$2" start="$3"
  local n=${#MENU_ITEMS[@]} i r def=$((start+1))
  printf "     ${D}%s:${R}\n" "$title" >&2
  for i in $(seq 0 $((n-1))); do
    printf "       ${A}%d)${R} %s%s\n" "$((i+1))" "${MENU_ITEMS[$i]}" "${MENU_NOTES[$i]}" >&2
  done
  while :; do
    printf "     ${A}Pick${R} ${D}[%s]${R} ${A}›${R} " "$def" >&2
    read -r r || { [ "$skip" -ge 0 ] && printf '%s' "$skip" || printf '%s' "$start"; return 0; }  # EOF: back out, never spin
    [ -n "$r" ] || r="$def"
    case "$r" in *[!0-9]*|'') continue ;; esac
    [ "$r" -ge 1 ] && [ "$r" -le "$n" ] && { printf '%s' "$((r-1))"; return 0; }
  done
}
ask(){ # $1 label  $2 default -> prints default if the user just hits Enter
  local r; printf "     ${A}%s${R} ${D}[%s]${R} ${A}›${R} " "$1" "${2:-none}" >&2
  read -r r; printf '%s' "${r:-$2}"; }
ask_secret(){ local r; printf "     ${A}%s${R} ${D}[%s]${R} ${A}›${R} " "$1" "${2:-none}" >&2
  stty -echo 2>/dev/null; read -r r; stty echo 2>/dev/null; printf '\n' >&2
  printf '%s' "${r:-$2}"; }
ask_yn(){ local r d; [ "$2" = true ] && d="yes" || d="no"
  printf "     ${A}%s${R} ${D}(y/n) [%s]${R} ${A}›${R} " "$1" "$d" >&2
  read -r r; case "$r" in [yY]*) echo true ;; [nN]*) echo false ;; *) echo "$2" ;; esac; }

# ── loading ───────────────────────────────────────────────────────────────
APP_NAMES=(); APP_IDS=()
load_apps(){ APP_NAMES=(); APP_IDS=()
  while IFS=$'\t' read -r n i; do [ -n "$n" ] && { APP_NAMES+=("$n"); APP_IDS+=("$i"); }; done < <(cfg apps); }

ACC_NAMES=()
load_accounts(){ ACC_NAMES=(); MENU_ITEMS=(); MENU_NOTES=()
  while IFS=$'\t' read -r n u c; do
    [ -n "$n" ] || continue
    ACC_NAMES+=("$n")
    MENU_ITEMS+=("$(printf '%-16s' "$n")")
    MENU_NOTES+=("  ${D}$(printf '%-28s' "$u")${R}")
  done < <(cfg accounts); }

PROJ_KEYS=(); PROJ_PATHS=()
load_projects(){ PROJ_KEYS=(); PROJ_PATHS=(); MENU_ITEMS=(); MENU_NOTES=()
  local gone
  while IFS=$'\t' read -r k path app id n acct; do
    [ -n "$k" ] || continue
    PROJ_KEYS+=("$k"); PROJ_PATHS+=("$path")
    [ -d "$path" ] && gone="" || gone="  ${Y}folder missing${R}"
    MENU_ITEMS+=("$(printf '%-22s' "${app:-$k}")")
    MENU_NOTES+=("  ${A}$(printf '%-16s' "${acct:-no account}")${R}${D}To: ${n}${R}$gone")
  done < <(cfg projects); }

# ── project detection ─────────────────────────────────────────────────────
# Walks up from the working directory; a pubspec.yaml is what makes it a project.
find_root(){
  local d="$PWD"
  while [ "$d" != "/" ]; do
    [ -f "$d/pubspec.yaml" ] && { printf '%s' "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
proj_version(){ # $1 root -> "1.0.0+104" from pubspec, or a date stamp
  local v; v="$(sed -n 's/^version: *//p' "$1/pubspec.yaml" 2>/dev/null | head -1 | tr -d ' \r')"
  printf '%s' "${v:-$(date '+%Y.%m.%d-%H%M')}"
}
# fvm pins a Flutter version per project; use it when the project says to.
flutter_cmd(){ # $1 root
  if [ -f "$1/.fvmrc" ] || [ -d "$1/.fvm" ]; then
    have fvm && { printf 'fvm flutter'; return; }
    warn "this project pins Flutter with fvm but fvm is not installed — using plain flutter" >&2
  fi
  printf 'flutter'
}

# ── build ─────────────────────────────────────────────────────────────────
last_build(){ # $1 root -> newest release apk inside that project, if any
  local f; f="$(ls -t "$1"/build/app/outputs/flutter-apk/app-release.apk \
                      "$1"/build/app/outputs/apk/release/app-release.apk 2>/dev/null | head -1)"
  printf '%s' "$f"
}
build_apk(){ # $1 root -> echoes the apk path on stdout, nothing else
  local root="$1" fl out log pid started elapsed last
  fl="$(flutter_cmd "$root")"
  log="$LOGS/$(basename "$root")-build.log"
  step "Building"
  row "project" "$(basename "$root")"
  row "flutter" "$fl"
  row "version" "$(proj_version "$root")"
  row "log" "${D}$log${R}"

  if [ "$VERBOSE" = yes ]; then
    printf "\n" >&2
    ( cd "$root" && $fl build apk --release ) >&2 2>&1 || { warn "the build failed"; return 1; }
  else
    ( cd "$root" && $fl build apk --release ) >"$log" 2>&1 &
    pid=$!
    started=$(date +%s)
    # one line, rewritten in place: elapsed time plus whatever gradle last said
    while kill -0 "$pid" 2>/dev/null; do
      elapsed=$(( $(date +%s) - started ))
      last="$(tr -d '\r' < "$log" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -1 | cut -c1-52)"
      printf "\r\033[K     ${A}▪${R} ${D}%3ds${R}  %s" "$elapsed" "$last" >&2
      sleep 1
    done
    wait "$pid"
    if [ $? -ne 0 ]; then
      printf "\r\033[K" >&2
      warn "the build failed — last lines of $log:"
      tr -d '\r' < "$log" | tail -15 | while IFS= read -r l; do sub "$l"; done
      return 1
    fi
    elapsed=$(( $(date +%s) - started ))
    printf "\r\033[K" >&2
    ok "built in ${elapsed}s  ${D}(run with -v to watch it)${R}"
  fi

  out="$(last_build "$root")"
  [ -n "$out" ] || { warn "the build reported success but no apk was found"; return 1; }
  printf '%s' "$out"
}

# ── notes ─────────────────────────────────────────────────────────────────
# What changed since the last time this project was shipped, so the mail says
# something. Falls back to whatever you type if the folder is not a git repo.
git_notes(){ # $1 root
  local since lines
  since="$(cfg proj_get "$2" last_sha)"
  [ -d "$1/.git" ] || return 0
  if [ -n "$since" ] && ( cd "$1" && git cat-file -e "$since^{commit}" 2>/dev/null ); then
    lines="$( cd "$1" && git log --format='- %s' "$since..HEAD" 2>/dev/null | head -8 )"
  else
    lines="$( cd "$1" && git log --format='- %s' -5 2>/dev/null )"
  fi
  printf '%s' "$lines"
}
head_sha(){ [ -d "$1/.git" ] && ( cd "$1" && git rev-parse HEAD 2>/dev/null ); }

# ── mail ──────────────────────────────────────────────────────────────────
# One ordinary email: To and CC are in the headers and see each other,
# BCC only goes to the envelope so nobody can see it.
send_mail(){ # $1 project key  $2 app label  $3 version  $4 link  $5 notes  $6 dry("yes" prints instead of sending)
python3 - "$CONFIG" "$@" <<'PY'
import json, smtplib, ssl, sys
from email.message import EmailMessage
from email.utils import formataddr

cfgp, key, app, version, link, notes = sys.argv[1:7]
dry = (len(sys.argv) > 7 and sys.argv[7] == "yes")
d = json.load(open(cfgp))
s = d["smtp"]
tpl = d["template"]
p = d["projects"].get(key, {})
def people(f):
    return [r for r in p.get(f, p.get({"to": "recipients", "bcc": "team"}.get(f, ""), [])) if r.get("email", "").strip()]
to, cc = people("to"), people("cc")
seen = {r["email"].strip() for r in to + cc}
bcc = list(dict.fromkeys(e for e in [r["email"].strip() for r in people("bcc")] + [e.strip() for e in s.get("bcc", []) if e.strip()] if e not in seen))

if not to:
    print("NO_RECIPIENTS"); sys.exit(0)

names = [r.get("name") or r["email"].split("@")[0] for r in to]
sender_name = s.get("from_name") or s["user"]
fields = dict(name=" and ".join([", ".join(names[:-1]), names[-1]]) if len(names) > 1 else names[0],
              app=app, version=version, link=link, sender=sender_name,
              notes=("\n\nWhat changed:\n" + notes) if notes.strip() else "")
m = EmailMessage()
m["Subject"] = (p.get("subject") or tpl["subject"]).format(**fields)
m["From"] = formataddr((sender_name, s.get("user", "")))
m["To"] = ", ".join(formataddr((r.get("name", ""), r["email"].strip())) for r in to)
if cc:
    m["Cc"] = ", ".join(formataddr((r.get("name", ""), r["email"].strip())) for r in cc)
if s.get("reply_to"):
    m["Reply-To"] = s["reply_to"]
m.set_content(tpl["body"].format(**fields))

if dry:
    print("-" * 60)
    print("From:    " + m["From"])
    print("To:      " + m["To"])
    if cc:  print("CC:      " + m["Cc"])
    if bcc: print("BCC:     " + ", ".join(bcc) + "   (hidden — nobody sees these)")
    print("Subject: " + m["Subject"])
    print()
    print(m.get_content())
    print("-" * 60)
    print("DRY\t%d" % (len(to) + len(cc) + len(bcc)))
    sys.exit(0)

port = int(s.get("port") or 465)
try:
    if port == 465:
        server = smtplib.SMTP_SSL(s["host"], port, context=ssl.create_default_context(), timeout=30)
    else:
        server = smtplib.SMTP(s["host"], port, timeout=30)
        server.starttls(context=ssl.create_default_context())
    server.login(s["user"], s["password"])
    refused = server.send_message(m, to_addrs=[r["email"].strip() for r in to + cc] + bcc)
    server.quit()
except Exception as e:
    print("FAIL\t" + str(e).replace("\n", " ")); sys.exit(1)
print("OK\t%d\t%s" % (len(to) + len(cc) + len(bcc) - len(refused), "; ".join(refused)))
PY
}

# ── upload ────────────────────────────────────────────────────────────────
UPLOAD_LINK=""
do_upload(){ # $1 apk  $2 app_id  $3 app name  $4 version  $5 account -> sets UPLOAD_LINK
  local apk="$1" app_id="$2" name="$3" version="$4" acct="$5"
  local user_id key url link code sent live copied err rc try bytes
  UPLOAD_LINK=""
  user_id="$(cfg acct_get "$acct" user_id)"; key="$(cfg acct_get "$acct" key)"
  [ -n "$user_id" ] && [ -n "$key" ] || { warn "account “${acct}” has no credentials yet"; return 1; }

  bytes="$(stat -f '%z' "$apk")"
  if [ "$bytes" -gt $((MAX_MB * 1048576)) ]; then
    warn "$((bytes / 1048576)) MB is over the ${MAX_MB} MB free-tier limit — appho.st will probably reject it"
    [ "$(ask_yn "Try the upload anyway" true)" = true ] || return 1
  fi

  while read -rst 0 -n 10000 _ 2>/dev/null; do :; done   # drop arrow keys typed during the menus
  step "Uploading"
  row "build" "$(basename "$apk")  ${D}$((bytes / 1048576)) MB${R}"
  row "app" "$name  ${D}(${acct})${R}"
  row "version" "$version"
  printf "\n"

  # no -f: appho.st reports problems as a 4xx with the reason in the body.
  err="$(mktemp -t makeabuild)"
  url="$(curl -sSG "$API/get_upload_url" \
    --data-urlencode "user_id=$user_id" --data-urlencode "app_id=$app_id" \
    --data-urlencode "key=$key" --data-urlencode "platform=android" \
    --data-urlencode "version=$version" 2>"$err")"
  rc=$?
  case "$url" in
    https://*) rm -f "$err" ;;
    "") warn "appho.st sent nothing back (curl exit $rc)"
        [ -s "$err" ] && sub "$(tr -d '\r' < "$err" | head -3)"
        rm -f "$err"; return 1 ;;
    *)  warn "appho.st refused: $url"
        sub "the three values come from the app page › Private API › download config"
        rm -f "$err"; return 1 ;;
  esac

  # curl exits 0 on a 4xx from storage, so the status code is the real verdict
  # curl's own bar is a wall of hashes; show one line that rewrites in place instead
  local pf; pf="$(mktemp -t mabpct)"
  ( curl -H 'Content-Type: application/octet-stream' \
      -T "$apk" "$url" -o /dev/null -w '%{http_code} %{size_upload}' \
      --progress-bar 2>"$pf" ) > "$pf.out" &
  local cpid=$!
  while kill -0 "$cpid" 2>/dev/null; do
    # only worth redrawing on a real terminal; piped output would just repeat
    [ -t 2 ] && printf "\r\033[K     ${A}▪${R} ${D}uploading${R}  %s" \
      "$(tr '\r' '\n' < "$pf" 2>/dev/null | grep -o '[0-9.]*%' | tail -1)" >&2
    sleep 1
  done
  wait "$cpid"; [ -t 2 ] && printf "\r\033[K" >&2
  code="$(cat "$pf.out" 2>/dev/null)"; rm -f "$pf" "$pf.out"
  [ -n "$code" ] || { warn "upload failed"; return 1; }
  sent="${code#* }"; code="${code%% *}"
  case "$code" in 2??) ;; *) warn "storage rejected the build (HTTP $code)"; return 1 ;; esac

  # the link appears a moment after the PUT lands, so give it a few tries
  for try in 1 2 3 4 5; do
    link="$(curl -sG "$API/get_current_version/" \
      --data-urlencode "u=$user_id" --data-urlencode "a=$app_id" --data-urlencode "platform=android" \
      | python3 -c 'import json,sys;print(json.load(sys.stdin).get("url",""))' 2>/dev/null)"
    [ -n "$link" ] && break
    sleep 2
  done
  live="$(curl -sG "$API/get_current_version/" \
    --data-urlencode "u=$user_id" --data-urlencode "a=$app_id" --data-urlencode "platform=android" \
    | python3 -c 'import json,sys;print(json.load(sys.stdin).get("version",""))' 2>/dev/null)"

  step "Uploaded"
  row "app" "$name  ${D}(${acct})${R}"
  if [ "$live" = "$version" ]; then
    row "version" "$live  ${G}confirmed live on appho.st${R}"
  elif [ -n "$live" ]; then
    row "version" "sent $version, but appho.st still serves ${Y}$live${R}"
  else
    row "version" "$version  ${Y}(appho.st did not confirm it yet)${R}"
  fi
  row "sent" "$((sent / 1048576)) MB · HTTP $code"
  row "when" "$(date '+%d %b %Y, %H:%M')"
  if [ -n "$link" ]; then
    printf %s "$link" | pbcopy 2>/dev/null && copied="  ${D}copied${R}"
    row "link" "${B}${A}${link}${R}$copied"
    have qrencode && { printf "\n"; qrencode -t ANSIUTF8 -m 2 "$link"; }
    UPLOAD_LINK="$link"
  else
    warn "no link returned yet — it usually appears on the dashboard within a minute"
    return 1
  fi
}

# ── ship ──────────────────────────────────────────────────────────────────
ship(){ # $1 project key  $2 root
  local key="$1" root="$2" apk app_id name version notes idx result count fails want_mail acct
  version="$(proj_version "$root")"
  app_id="$(cfg proj_get "$key" app_id)"
  name="$(cfg proj_get "$key" app)"
  [ -n "$app_id" ] || { warn "“${key}” has no app id yet"; project_menu "$key" || return; app_id="$(cfg proj_get "$key" app_id)"; }
  [ -n "$app_id" ] || return
  [ -n "$name" ] || name="$key"
  acct="$(proj_account "$key")"
  [ -n "$acct" ] || return

  # Everything that needs an answer is asked here, before the build starts, so
  # the rest runs unattended. The choice becomes next time's default.
  want_mail="$(cfg proj_get "$key" mail_default)"
  case "$want_mail" in false|none|"") want_mail=no ;; *) want_mail=yes ;; esac
  if [ -z "$(cfg people "$key" to)" ]; then
    want_mail=no; warn "no email will be sent — To is empty (add people on the app screen)"
  else
    mail_summary "$key" "$name" "$version"
    MENU_ITEMS=("send this email" "don't send an email this time")
    MENU_NOTES=("  ${D}after the upload${R}" "  ${D}still uploads and copies the link${R}")
    [ "$want_mail" = yes ] && idx=0 || idx=1
    [ "$(menu_pick "Email" 1 "$idx")" = 0 ] && want_mail=yes || want_mail=no
    cfg proj_set "$key" mail_default "$want_mail"
  fi
  if [ "$want_mail" = yes ] && [ "$(cfg smtp_ready)" != yes ]; then
    warn "no mail account is set up yet"; smtp_menu
    [ "$(cfg smtp_ready)" = yes ] || want_mail=no
  fi

  apk="$(last_build "$root")"
  MENU_ITEMS=("build a fresh one"); MENU_NOTES=("  ${D}$(flutter_cmd "$root") build apk --release${R}")
  if [ -n "$apk" ]; then
    MENU_ITEMS+=("use the last build")
    MENU_NOTES+=("  ${D}$(date -r "$(stat -f '%m' "$apk")" '+%d %b %H:%M')  $(( $(stat -f '%z' "$apk") / 1048576 )) MB${R}")
  fi
  MENU_ITEMS+=("← cancel"); MENU_NOTES+=("")
  step "Build"
  idx="$(menu_pick "Which build" $(( ${#MENU_ITEMS[@]} - 1 )) 0)"
  [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 1 )) ] && return
  if [ "$idx" -eq 0 ]; then
    apk="$(build_apk "$root")" || return
  fi
  [ -n "$apk" ] || return

  # nothing below this line asks anything — walk away
  do_upload "$apk" "$app_id" "$name" "$version" "$acct" || return

  [ "$want_mail" = yes ] || { log_send "$key" "$version" "$UPLOAD_LINK" "0 (link only)"; return; }

  notes="$(git_notes "$root" "$key")"
  if [ "$DRY" = yes ]; then
    step "Dry run — this is what would be sent"
    send_mail "$key" "$name" "$version" "$UPLOAD_LINK" "$notes" yes
    warn "dry run: nothing was mailed"
    log_send "$key" "$version" "$UPLOAD_LINK" "0 (dry run)"
    return
  fi

  step "Sending"
  result="$(send_mail "$key" "$name" "$version" "$UPLOAD_LINK" "$notes")"
  case "$result" in
    OK*) count="$(printf '%s' "$result" | cut -f2)"; fails="$(printf '%s' "$result" | cut -f3)"
         ok "sent to $count address$([ "$count" = 1 ] || echo es)"
         [ -n "$fails" ] && warn "failed: $fails"
         cfg proj_set "$key" last_sha "$(head_sha "$root")"
         log_send "$key" "$version" "$UPLOAD_LINK" "$count" ;;
    NO_RECIPIENTS) warn "no recipients saved" ;;
    FAIL*) warn "could not connect: $(printf '%s' "$result" | cut -f2)"
           sub "check host, port, address and password under Mail account" ;;
  esac
}

mail_summary(){ # $1 key  $2 app  $3 version — the email exactly as it will go out
  local key="$1" subj n e any f
  subj="$(cfg proj_get "$key" subject)"; [ -n "$subj" ] || subj="$(cfg tpl_get subject)"
  subj="${subj//\{app\}/$2}"; subj="${subj//\{version\}/$3}"
  step "Email"
  for f in to cc bcc; do
    any=""
    while IFS=$'\t' read -r n e; do
      [ -n "$e" ] && { row "${any:-$([ "$f" = to ] && echo To || printf '%s' "$f" | tr a-z A-Z)}" "${n:+$n  }${D}$e${R}"; any=" "; }
    done < <(cfg people "$key" "$f")
    [ "$f" = bcc ] && while IFS= read -r e; do
      [ -n "$e" ] && { row "${any:-BCC}" "${D}$e  (copy to me, every app)${R}"; any=" "; }
    done < <(cfg bcc)
    [ -n "$any" ] || row "$([ "$f" = to ] && echo To || printf '%s' "$f" | tr a-z A-Z)" "${D}—${R}"
  done
  row "Subject" "$subj"
  sub "To and CC see each other · BCC is hidden, nobody sees it"
}

log_send(){ # project · version · link · how many were mailed
  printf '%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" "$2" "$4" "$3" >> "$LOGS/$1.log"
}

# The account belongs to the project, so shipping never needs a global switch.
proj_account(){ # $1 project key -> echoes the account name, asking once if unknown
  local key="$1" n
  n="$(cfg proj_acct "$key")"
  [ -n "$n" ] && { printf '%s' "$n"; return; }
  step "Which appho.st account owns “${key}”"
  n="$(pick_account "Account")" || return 1
  cfg proj_set "$key" account "$n"
  printf '%s' "$n"
}

pick_account(){ # $1 title -> echoes an account name, offering to add a new one
  local idx n
  load_accounts
  MENU_ITEMS+=("+ add an account"); MENU_NOTES+=("  ${D}user_id and API key from appho.st${R}")
  idx="$(menu_pick "$1" -1 0)"
  if [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 1 )) ]; then
    n="$(ask "Label for the account" "")"
    [ -n "$n" ] || return 1
    cfg acct_add "$n"; credentials
  else n="${ACC_NAMES[$idx]}"; fi
  printf '%s' "$n"
}

add_app(){ # $1 folder (optional) -> echoes the new project key
  local root="${1:-}" key acct
  step "Add an app"
  while [ ! -f "$root/pubspec.yaml" ]; do
    root="$(ask "Flutter project folder" "")"
    [ -n "$root" ] || return 1
    root="${root/#\~/$HOME}"
    [ -f "$root/pubspec.yaml" ] || warn "no pubspec.yaml in that folder"
  done
  key="$(basename "$root")"
  cfg proj_set "$key" path "$root"
  cfg proj_set "$key" app "$(ask "App name (shown in the email)" "$(cfg proj_get "$key" app | grep . || echo "$key")")"
  acct="$(pick_account "Which appho.st account it uploads to")" || return 1
  cfg proj_set "$key" account "$acct"
  cfg proj_set "$key" app_id "$(ask "appho.st app id" "$(cfg proj_get "$key" app_id)")"
  ok "saved “$(cfg proj_get "$key" app)” under “${acct}”"
  printf '%s' "$key"
}

# ── config menus ──────────────────────────────────────────────────────────
credentials(){
  step "appho.st credentials for “$(cfg current)”"
  sub "both come from the app's page on appho.st › Private API › download config"
  cfg set user_id "$(ask "user_id" "$(cfg get user_id)")"
  cfg set key     "$(ask "API key" "$(cfg get key)")"
  ok "saved"
}

accounts_menu(){
  local idx name new c
  while :; do
    load_accounts
    MENU_ITEMS+=("+ add an account") ; MENU_NOTES+=("  ${D}a second free tier${R}")
    MENU_ITEMS+=("← back")           ; MENU_NOTES+=("")
    step "appho.st accounts"
    idx="$(menu_pick "Which account" $(( ${#MENU_ITEMS[@]} - 1 )) 0)"
    [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 1 )) ] && return
    if [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 2 )) ]; then
      name="$(ask "Label for it" "")"
      [ -n "$name" ] && { cfg acct_add "$name"; ok "added “${name}” and switched to it"; credentials; }
      continue
    fi
    name="${ACC_NAMES[$idx]}"
    MENU_ITEMS=("switch to it" "edit credentials" "rename" "delete" "← back")
    MENU_NOTES=("" "" "" "" "")
    step "$name"
    idx="$(menu_pick "What to do" 4 0)"
    case "$idx" in
      0) cfg switch "$name"; ok "now using “${name}”"; return ;;
      1) cfg switch "$name"; credentials ;;
      2) new="$(ask "New label" "$name")"; [ -n "$new" ] && { cfg acct_ren "$name" "$new"; ok "renamed to “${new}”"; } ;;
      3) c="$(ask_yn "Delete “${name}” and its app ids" false)"
         [ "$c" = true ] && { cfg acct_del "$name" && ok "deleted “${name}”" || warn "that is your only account"; } ;;
    esac
  done
}

smtp_menu(){
  local idx e
  while :; do
    MENU_ITEMS=("$(printf '%-16s' 'address')"  "$(printf '%-16s' 'password')"
                "$(printf '%-16s' 'smtp host')" "$(printf '%-16s' 'port')"
                "$(printf '%-16s' 'from name')" "$(printf '%-16s' 'reply-to')"
                "$(printf '%-16s' 'copy to me')"    "send a test to myself" "← back")
    MENU_NOTES=("  ${D}$(cfg smtp_get user)${R}"
                "  ${D}$([ -n "$(cfg smtp_get password)" ] && echo 'set' || echo 'not set yet')${R}"
                "  ${D}$(cfg smtp_get host)${R}"
                "  ${D}$(cfg smtp_get port)  · 465 for SSL, 587 for STARTTLS${R}"
                "  ${D}$(cfg smtp_get from_name)  · the sender name people see${R}"
                "  ${D}$(cfg smtp_get reply_to)  · a real inbox, if replies should land somewhere${R}"
                "  ${D}$(cfg bcc | tr '\n' ' ')  · BCC on every email, nobody sees it${R}"
                "  ${D}proves the settings work before a real send${R}" "")
    step "Mail account"
    idx="$(menu_pick "What to change" 8 0)"
    case "$idx" in
      0) cfg smtp_set user      "$(ask "Address" "$(cfg smtp_get user)")" ;;
      1) cfg smtp_set password  "$(ask_secret "Password" "")" ; ok "saved" ;;
      2) cfg smtp_set host      "$(ask "SMTP host" "$(cfg smtp_get host)")" ;;
      3) cfg smtp_set port      "$(ask "Port" "$(cfg smtp_get port)")" ;;
      4) cfg smtp_set from_name "$(ask "From name" "$(cfg smtp_get from_name)")" ;;
      5) cfg smtp_set reply_to  "$(ask "Reply-to" "$(cfg smtp_get reply_to)")" ;;
      6) e="$(ask "Your address for a hidden copy (blank clears)" "$(cfg bcc | head -1)")"
         while IFS= read -r old; do [ -n "$old" ] && cfg bcc_del "$old"; done < <(cfg bcc)
         [ -n "$e" ] && cfg bcc_add "$e"; ok "saved" ;;
      7) smtp_test ;;
      8) return ;;
    esac
  done
}

smtp_test(){
  local to result
  [ "$(cfg smtp_ready)" = yes ] || { warn "fill in address, password and host first"; return; }
  to="$(ask "Send the test to" "$(cfg smtp_get user)")"
  [ -n "$to" ] || return
  cfg proj_set "__test" app "Test"
  cfg person_add "__test" "you" "$to"
  step "Sending test"
  result="$(send_mail "__test" "make-a-build" "0.0.0" "https://appho.st" "- this is a test")"
  cfg proj_del "__test"
  case "$result" in
    OK*) ok "delivered — check $to (and its spam folder)" ;;
    FAIL*) warn "$(printf '%s' "$result" | cut -f2)" ;;
    *) warn "no recipients" ;;
  esac
}

people_menu(){ # $1 project key  $2 to | cc | bcc
  local key="$1" list="${2:-to}" idx n e names=() mails=() i label
  [ "$list" = to ] && label=To || label="$(printf '%s' "$list" | tr a-z A-Z)"
  while :; do
    names=(); mails=(); MENU_ITEMS=(); MENU_NOTES=()
    while IFS=$'\t' read -r n e; do
      [ -n "$e" ] || continue
      names+=("$n"); mails+=("$e")
      MENU_ITEMS+=("$(printf '%-22s' "${n:-—}")"); MENU_NOTES+=("  ${D}${e}${R}")
    done < <(cfg people "$key" "$list")
    MENU_ITEMS+=("+ add to $label"); MENU_NOTES+=("  ${D}name and address${R}")
    MENU_ITEMS+=("← back");         MENU_NOTES+=("")
    step "$label for “${key}”"
    case "$list" in
      to)  sub "who the email is addressed to — To and CC see each other" ;;
      cc)  sub "copied openly — everyone on the email can see these" ;;
      bcc) sub "hidden copy — nobody on the email can see these (testers, QA)" ;;
    esac
    idx="$(menu_pick "Who" $(( ${#MENU_ITEMS[@]} - 1 )) 0)"
    [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 1 )) ] && return
    if [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 2 )) ]; then
      n="$(ask "Their name" "")"; e="$(ask "Their address" "")"
      case "$e" in ?*@?*.?*) cfg person_add "$key" "$n" "$e" "$list"; ok "added ${e}" ;;
                   "") ;; *) warn "“${e}” is not an email address" ;; esac
      continue
    fi
    MENU_ITEMS=("rename" "change address" "remove" "← back"); MENU_NOTES=("" "" "" "")
    step "${names[$idx]:-${mails[$idx]}}"
    i="$(menu_pick "What to do" 3 0)"
    case "$i" in
      0) cfg person_add "$key" "$(ask "Name" "${names[$idx]}")" "${mails[$idx]}" "$list"; ok "renamed" ;;
      1) e="$(ask "Address" "${mails[$idx]}")"
         case "$e" in ?*@?*.?*) ;; *) warn "“${e}” is not an email address"; continue ;; esac
         { cfg person_del "$key" "${mails[$idx]}" "$list"; cfg person_add "$key" "${names[$idx]}" "$e" "$list"; ok "updated"; } ;;
      2) [ "$(ask_yn "Remove ${mails[$idx]}" false)" = true ] && { cfg person_del "$key" "${mails[$idx]}" "$list"; ok "removed"; } ;;
    esac
  done
}

app_screen(){ # $1 project key -> returns when the user goes back to the list
  local key="$1" name
  while :; do
    name="$(cfg proj_get "$key" app)"; [ -n "$name" ] || name="$key"
    printf "\n  ${D}%s${R}\n  ${B}%s${R}  ${D}uploads to${R} ${B}%s${R}\n" "$RULE" "$name" "$(cfg proj_acct "$key")"
    mail_summary "$key" "$name" "$(proj_version "$(cfg proj_get "$key" path)")"
    MENU_ITEMS=("build and upload" "edit To" "edit CC" "edit BCC" "edit Subject" "app details" "← back to apps")
    MENU_NOTES=("  ${D}then send the email above, if you want${R}"
                "  ${D}who the email is for${R}"
                "  ${D}copied, everyone can see them${R}"
                "  ${D}hidden copy, nobody can see them${R}"
                "  ${D}blank = default${R}"
                "  ${D}name, app id, folder, account, remove${R}" "")
    case "$(menu_pick "What to do" 6 0)" in
      0) ship "$key" "$(cfg proj_get "$key" path)" ;;
      1) people_menu "$key" to ;;
      2) people_menu "$key" cc ;;
      3) people_menu "$key" bcc ;;
      4) cfg proj_set "$key" subject "$(ask "Subject (blank = default)" "$(cfg proj_get "$key" subject)")" ;;
      5) project_menu "$key" || return ;;
      6) return ;;
    esac
  done
}

project_menu(){ # $1 project key -> returns 1 if the app was removed
  local key="$1" idx v
  while :; do
    MENU_ITEMS=("$(printf '%-16s' 'app name')" "$(printf '%-16s' 'app id')"
                "$(printf '%-16s' 'folder')"   "$(printf '%-16s' 'account')"
                "remove this app" "← back")
    MENU_NOTES=("  ${D}$(cfg proj_get "$key" app)  · used in the email${R}"
                "  ${D}$(cfg proj_get "$key" app_id)  · from the appho.st app page${R}"
                "  ${D}$(cfg proj_get "$key" path)${R}"
                "  ${D}$(cfg proj_acct "$key")  · appho.st account it uploads to${R}" "" "")
    step "App details"
    idx="$(menu_pick "What to change" 5 0)"
    case "$idx" in
      0) cfg proj_set "$key" app    "$(ask "App name" "$(cfg proj_get "$key" app)")" ;;
      1) cfg proj_set "$key" app_id "$(ask "App id" "$(cfg proj_get "$key" app_id)")" ;;
      2) v="$(ask "Folder" "$(cfg proj_get "$key" path)")"
         [ -d "$v" ] && cfg proj_set "$key" path "$v" || warn "no such folder" ;;
      3) v="$(pick_account "Which account it uploads to")" && { cfg proj_set "$key" account "$v"; ok "now uploads to “${v}”"; } ;;
      4) [ "$(ask_yn "Remove “${key}” and its email lists" false)" = true ] && { cfg proj_del "$key"; ok "removed"; return 1; } ;;
      5) return 0 ;;
    esac
  done
}

projects_menu(){
  local idx
  while :; do
    load_projects
    MENU_ITEMS+=("← back"); MENU_NOTES+=("")
    step "Projects"
    idx="$(menu_pick "Which project" $(( ${#MENU_ITEMS[@]} - 1 )) 0)"
    [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 1 )) ] && return
    app_screen "${PROJ_KEYS[$idx]}"
