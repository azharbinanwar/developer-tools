# ── main ──────────────────────────────────────────────────────────────────
DRY=no
VERBOSE=no
for arg in "$@"; do
  case "$arg" in
    --dry-run|-n) DRY=yes ;;
    --verbose|-v) VERBOSE=yes ;;
    config|-c)    cfg current >/dev/null; banner "make-a-build $VERSION" "settings"; config_menu; exit 0 ;;
    -h|--help)
      printf "\n  ${B}make-a-build${R} ${D}%s${R}\n\n" "$VERSION"
      printf "    ${A}make-a-build${R}             build, upload, and optionally mail the link\n"
      printf "    ${A}make-a-build --dry-run${R}   same, but print the mail instead of sending it\n"
      printf "    ${A}make-a-build --verbose${R}   stream the full build log instead of one line\n"
      printf "    ${A}make-a-build config${R}      apps, email lists, mail account, template\n\n"
      printf "  ${D}Run it inside a project and it offers to remember that project.\n"
      printf "  Run it anywhere else and it asks which saved project to ship.\n"
      printf "  Everything lives in %s${R}\n\n" "$HOME_DIR"
      exit 0 ;;
  esac
done

cfg current >/dev/null   # creates config.json, adopting ~/.apphost on first run
banner "make-a-build $VERSION" "build it, ship it, mail the link"
[ "$DRY" = yes ] && sub "${Y}dry run — it will upload but send no mail${R}"

KEY=""; ROOT=""
if ROOT="$(find_root)"; then
  KEY="$(basename "$ROOT")"
  if [ -z "$(cfg proj_get "$KEY" path)" ]; then
    step "New app"
    row "folder" "$ROOT"
    row "version" "$(proj_version "$ROOT")"
    if [ "$(ask_yn "Add it to your apps" true)" = true ]; then
      KEY="$(add_app "$ROOT")" || KEY=""
    else
      KEY=""
    fi
  else
    # the folder may have moved since it was saved
    [ "$(cfg proj_get "$KEY" path)" = "$ROOT" ] || cfg proj_set "$KEY" path "$ROOT"
  fi
fi

while :; do
  if [ -n "$KEY" ]; then
    app_screen "$KEY"; KEY=""
  else
    load_projects
    MENU_ITEMS+=("+ add an app"); MENU_NOTES+=("  ${D}a Flutter folder, an account, an app id${R}")
    MENU_ITEMS+=("settings");     MENU_NOTES+=("  ${D}mail, accounts, template${R}")
    MENU_ITEMS+=("quit");         MENU_NOTES+=("")
    printf "\n  ${D}%s${R}\n" "$RULE"
    step "Apps"
    idx="$(menu_pick "Pick an app" $(( ${#MENU_ITEMS[@]} - 1 )) 0)"
    if   [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 1 )) ]; then printf "\n"; exit 0
    elif [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 2 )) ]; then config_menu
    elif [ "$idx" -eq $(( ${#MENU_ITEMS[@]} - 3 )) ]; then KEY="$(add_app)" || KEY=""
    else
      KEY="${PROJ_KEYS[$idx]}"
      [ -d "${PROJ_PATHS[$idx]}" ] || warn "“${KEY}” points at a folder that no longer exists — fix it under app details"
    fi
  fi
done
