template_menu(){
  local idx
  while :; do
    MENU_ITEMS=("subject" "body" "← back"); MENU_NOTES=("  ${D}$(cfg tpl_get subject)${R}" "" "")
    step "Mail template"
    sub "placeholders: {name} {app} {version} {link} {notes} {sender}"
    idx="$(menu_pick "What to change" 2 0)"
    case "$idx" in
