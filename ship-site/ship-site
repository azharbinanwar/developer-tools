#!/usr/bin/env bash
# ship-site: build a Vite site, publish only the dist folder to Vercel, copy the link.
#
# One file. Accounts are named and signed in either with a token or through
# the Vercel browser login; each keeps its own CLI session under
# ~/.config/ship-site/accounts/<name>. Projects are listed from the account and
# picked or created by name, never guessed. The deploy runs from a temp copy of
# dist/ outside your git repo, so no commit info is attached, and the copy is
# removed afterwards.
#
# Needs node, python3 and the Vercel CLI; it asks before installing node or the CLI.
#
# License: MIT.

set -uo pipefail

# ── looks ─────────────────────────────────────────────────────────────────
if [ -t 2 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  B=$(tput bold); D=$(tput dim); R=$(tput sgr0)
  A=$(tput setaf 6); G=$(tput setaf 2); Y=$(tput setaf 3); E=$(tput setaf 1)
else B=; D=; R=; A=; G=; Y=; E=; fi
VERSION="1.1.0"
banner(){ printf "\n  ${A}${B}◆  %s${R}  ${D}%s${R}\n" "$1" "${2:-}" >&2; }
step(){ printf "\n  ${A}${B}▸${R} ${B}%s${R}\n" "$1" >&2; }
sub(){ printf "     ${D}%s${R}\n" "$1" >&2; }
ok(){ printf "     ${G}✓${R} %s\n" "$1" >&2; }
warn(){ printf "     ${Y}!${R} %s\n" "$1" >&2; }
die(){ printf "\n  ${E}${B}✗ %s${R}\n" "$1" >&2; exit 1; }
row(){ printf "     ${D}%-11s${R} %s\n" "$1" "$2" >&2; }
cmd(){ printf "     ${D}\$${R} %s\n" "$1" >&2; }
have(){ command -v "$1" >/dev/null 2>&1; }
fail(){ # $1 message  $2 log file -> repeats the error lines from the log, then dies
  local l; printf "\n" >&2
  warn "$1"
  grep -i 'error\|fail\|denied\|not found\|cannot' "$2" 2>/dev/null | tail -6 | while IFS= read -r l; do sub "$l"; done
  die "stopped — full output is above"
}

CONF="$HOME/.config/ship-site"
CONFIG="$CONF/config.json"
ACCTS="$CONF/accounts"

# ── config + vercel api ───────────────────────────────────────────────────
# One python block owns config.json and talks to api.vercel.com; bash only asks it for lines.
vc(){
python3 - "$CONFIG" "$@" <<'PY'
import json, os, sys, urllib.request, urllib.error, urllib.parse

path, op = sys.argv[1], sys.argv[2]
a = sys.argv[3:]
try: d = json.load(open(path))
except Exception: d = {}
d.setdefault("accounts", {}); d.setdefault("projects", {})

def save():
    os.makedirs(os.path.dirname(path), exist_ok=True)
    json.dump(d, open(path, "w"), indent=2); os.chmod(path, 0o600)

class ApiErr(Exception): pass
sys.excepthook = lambda t, v, tb: print("ERR\t" + str(v)) if t is ApiErr else sys.__excepthook__(t, v, tb)

def api(token, team, method, ep, body=None):
    if team and team != "-": ep += ("&" if "?" in ep else "?") + urllib.parse.urlencode({"teamId": team})
    req = urllib.request.Request("https://api.vercel.com" + ep, method=method,
            data=json.dumps(body).encode() if body is not None else None,
            headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = r.read(); return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        try: msg = json.loads(e.read()).get("error", {}).get("message", str(e))
        except Exception: msg = str(e)
        raise ApiErr(msg)
    except urllib.error.URLError as e:
        raise ApiErr("cannot reach Vercel: %s" % e.reason)

def pages(token, team, ep, key):
    out, until = [], None
    while True:
        r = api(token, team, "GET", ep + ("&until=%s" % until if until else ""))
        out += r.get(key, [])
        until = r.get("pagination", {}).get("next")
        if not until: return out

# config
if   op == "accounts":  [print(n) for n in sorted(d["accounts"])]
elif op == "acct_get":  print(d["accounts"].get(a[0], {}).get(a[1], ""))
elif op == "acct_set":  d["accounts"].setdefault(a[0], {})[a[1]] = a[2]; save()
elif op == "acct_del":  d["accounts"].pop(a[0], None); save()
elif op == "proj_get":  print(d["projects"].get(a[0], {}).get(a[1], ""))
elif op == "proj_set":  d["projects"].setdefault(a[0], {})[a[1]] = a[2]; save()
# vercel
elif op == "user":      u = api(a[0], "-", "GET", "/v2/user")["user"]; print("%s\t%s" % (u["id"], u.get("username") or u.get("name", "")))
elif op == "teams":     [print("%s\t%s\t%s" % (t["id"], t["slug"], t.get("name", t["slug"]))) for t in pages(a[0], "-", "/v2/teams?limit=100", "teams")]
elif op == "refresh":   # every account's projects into the cache; a failing account keeps its last known rows
    base, old, new = os.path.join(os.path.dirname(path), "accounts"), d.get("cache", []), []
    for n in sorted(d["accounts"]):
        try:
            tf, af, tok = os.path.join(base, n, "token"), os.path.join(base, n, "auth.json"), ""
            if os.path.exists(tf): tok = open(tf).read().strip()
            elif os.path.exists(af): tok = json.load(open(af)).get("token", "")
            if not tok: raise ApiErr("not signed in")
            for p in pages(tok, d["accounts"][n].get("team_id") or "-", "/v9/projects?limit=100", "projects"):
                al = p.get("targets", {}).get("production", {}).get("alias") or []
                url = next((x for x in al if not x.endswith(".vercel.app")), None) or (al[0] if al else p["name"] + ".vercel.app")
                new.append({"account": n, "id": p["id"], "name": p["name"], "url": url})
        except Exception as e:
            sys.stderr.write("%s\t%s\n" % (n, e))
            new += [c for c in old if c.get("account") == n]
    d["cache"] = sorted(new, key=lambda c: (c["name"], c["account"])); save()
elif op == "cache_add": d.setdefault("cache", []).append({"account": a[0], "id": a[1], "name": a[2], "url": a[3]}); save()
elif op == "landing":   # cached projects with the folder each one was last built from
    folders = {}
    for f, pr in d["projects"].items(): folders.setdefault(pr.get("id"), f)
    for c in d.get("cache", []):
        if c["account"] in d["accounts"]: print("\t".join([c["account"], c["id"], c["name"], c["url"], folders.get(c["id"], "")]))
elif op == "create":    p = api(a[0], a[1], "POST", "/v10/projects", {"name": a[2], "framework": None}); print("%s\t%s" % (p["id"], p["name"]))
elif op == "domain":    # the stable production domain of a project, if any
    ds = [x["name"] for x in pages(a[0], a[1], "/v9/projects/%s/domains?limit=100" % a[2], "domains") if not x.get("gitBranch") and not x.get("redirect")]
    print(next((x for x in ds if not x.endswith(".vercel.app")), ds[0] if ds else ""))
else: sys.exit(2)
PY
}

# ── menus and prompts ─────────────────────────────────────────────────────
fit(){ # $1 text (may carry colour codes)  $2 width -> the text as is, or cut with … when it would wrap
  local plain
  plain="$(printf '%s' "$1" | sed -e $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' -e $'s/\x1b(B//g')"
  [ "${#plain}" -le "$2" ] && { printf '%s' "$1"; return; }
  printf '%s…' "${plain:0:$(( $2 - 1 ))}"
}
MENU_ITEMS=(); MENU_NOTES=()
menu_pick(){ # $1 title  $2 start index -> echoes chosen index
  local title="$1" n=${#MENU_ITEMS[@]} sel="$2" k rest i saved
  saved="$(stty -g 2>/dev/null || true)"
  printf '\033[?7l' >&2   # no wrapping while the menu is up: a long row is cut, not wrapped, so the redraw stays aligned
  [ -n "$saved" ] && { stty -echo -icanon 2>/dev/null; trap 'stty "$saved" 2>/dev/null; printf "\033[?7h" >&2; exit 130' INT; }
  printf "     ${D}%s  · ↑↓ move · Enter picks · q quits${R}\n" "$title" >&2
  for ((i=0;i<n;i++)); do printf '\n' >&2; done
  # rows are cut to the window width up front: a wrapped row would throw off the cursor-up redraw
  local w rows=(); w=$(( $(tput cols 2>/dev/null || echo 80) - 8 ))
  for ((i=0;i<n;i++)); do rows+=("$(fit "${MENU_ITEMS[$i]}${MENU_NOTES[$i]:-}" "$w")"); done
  while :; do
    printf "\033[%dA" "$n" >&2
    for ((i=0;i<n;i++)); do
      if [ "$i" -eq "$sel" ]; then printf "\r\033[K     ${A}❯ %s${R}\n" "${rows[$i]}" >&2
      else                         printf "\r\033[K       ${D}%s${R}\n" "${rows[$i]}" >&2; fi
    done
    IFS= read -rsn1 k 2>/dev/null || break
    case "$k" in
      '')    break ;;
      $'\e') IFS= read -rsn2 rest 2>/dev/null || rest=""
             case "$rest" in "[A") sel=$(((sel-1+n)%n)) ;; "[B") sel=$(((sel+1)%n)) ;; esac ;;
      k|K)   sel=$(((sel-1+n)%n)) ;;
      j|J)   sel=$(((sel+1)%n)) ;;
      q|Q)   [ -n "$saved" ] && stty "$saved" 2>/dev/null; printf '\033[?7h\n' >&2; exit 0 ;;
    esac
  done
  printf '\033[?7h' >&2
  [ -n "$saved" ] && { trap - INT; stty "$saved" 2>/dev/null; }
  printf '%s' "$sel"
}
ask(){ local r; printf "     ${A}%s${R}%s ${A}›${R} " "$1" "${2:+ ${D}[$2]${R}}" >&2; read -r r; printf '%s' "${r:-$2}"; }
ask_secret(){ # $1 label  $2 saved value -> one * per character typed; Enter on nothing keeps the saved value
  local r="" c
  printf "     ${A}%s${R} ${D}[%s]${R} ${A}›${R} " "$1" "$([ -n "${2:-}" ] && echo 'saved · Enter keeps it' || echo 'none')" >&2
  while IFS= read -rsn1 c; do
    case "$c" in
      '')            break ;;
      $'\177'|$'\b') [ -n "$r" ] && { r="${r%?}"; printf '\b \b' >&2; } ;;
      *)             r="$r$c"; printf '*' >&2 ;;
    esac
  done
  printf '\n' >&2
  printf '%s' "${r:-${2:-}}"
}

# ── accounts ──────────────────────────────────────────────────────────────
# Every account ends up with a token on disk: pasted ones in accounts/<name>/token,
# browser logins in the CLI's own accounts/<name>/auth.json. Same API path after that.
acct_token(){ # $1 name -> echoes the token
  local dir="$ACCTS/$1"
  [ -f "$dir/token" ] && { cat "$dir/token"; return; }
  [ -f "$dir/auth.json" ] && python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("token",""))' "$dir/auth.json"
}
AUTH=()
acct_cli(){ # $1 name -> fills AUTH with the vercel cli flags, as an array so a space in the name survives
  local dir="$ACCTS/$1"
  [ -f "$dir/token" ] && AUTH=(--token "$(cat "$dir/token")") || AUTH=(--global-config "$dir")
}

add_account(){ # -> echoes the new account name
  local name dir token user teams idx r
  step "Add a Vercel account"
  name="$(ask "A name for it (your name, or the team)" "")"; [ -n "$name" ] || return 1
  case "$name" in */*|.*) warn "no slashes or leading dots"; return 1 ;; esac
  [ -z "$(vc acct_get "$name" org_id)" ] || { warn "“${name}” exists already — pick it from the list"; return 1; }
  dir="$ACCTS/$name"; mkdir -p "$dir"; chmod 700 "$ACCTS" "$dir"
  MENU_ITEMS=("sign in with Vercel in the browser" "paste a token")
  MENU_NOTES=("  ${D}opens vercel.com, nothing to copy${R}" "  ${D}from vercel.com/account/tokens${R}")
  if [ "$(menu_pick "How" 0)" = 0 ]; then
    cmd "vercel login --global-config $dir"
    vercel login --global-config "$dir" >&2 || { rm -rf "$dir"; die "sign-in did not finish"; }
    rm -f "$dir/token"
  else
    sub "create one at https://vercel.com/account/tokens, then paste it here (hidden)"
    token="$(ask_secret "Token")"; [ -n "$token" ] || { rm -rf "$dir"; return 1; }
    printf '%s\n' "$token" > "$dir/token"; chmod 600 "$dir/token"
  fi
  token="$(acct_token "$name")"; [ -n "$token" ] || { rm -rf "$dir"; die "no token came back"; }
  user="$(vc user "$token")" || { rm -rf "$dir"; die "${user#ERR	}"; }
  ok "signed in as ${user#*	}"

  # scope: personal, or one of the teams the account belongs to
  teams="$(vc teams "$token")" || die "${teams#ERR	}"
  vc acct_set "$name" scope "${user#*	}"; vc acct_set "$name" org_id "${user%%	*}"; vc acct_set "$name" team_id ""
  if [ -n "$teams" ]; then
    MENU_ITEMS=("personal  ${user#*	}"); MENU_NOTES=("")
    while IFS=$'\t' read -r id slug tname; do MENU_ITEMS+=("team      $tname"); MENU_NOTES+=("  ${D}$slug${R}"); done <<<"$teams"
    step "Which scope does “${name}” deploy to"
    idx="$(menu_pick "Scope" 0)"
    if [ "$idx" -gt 0 ]; then
      r="$(sed -n "${idx}p" <<<"$teams")"
      vc acct_set "$name" team_id "$(cut -f1 <<<"$r")"; vc acct_set "$name" org_id "$(cut -f1 <<<"$r")"; vc acct_set "$name" scope "$(cut -f2 <<<"$r")"
    fi
  fi
  ok "saved “${name}”  ${D}→ $(vc acct_get "$name" scope)${R}"
  printf '%s' "$name"
}

pick_account(){ # -> echoes an account name
  local names=() n idx
  while :; do
    names=(); MENU_ITEMS=(); MENU_NOTES=()
    while IFS= read -r n; do [ -n "$n" ] && { names+=("$n"); MENU_ITEMS+=("$(printf '%-16s' "$n")"); MENU_NOTES+=("  ${D}$(vc acct_get "$n" scope)${R}"); }; done < <(vc accounts)
    MENU_ITEMS+=("+ add an account"); MENU_NOTES+=("  ${D}browser sign-in or a token${R}")
    step "Vercel account"
    idx="$(menu_pick "Which account" 0)"
    if [ "$idx" -eq ${#names[@]} ]; then n="$(add_account)" && { printf '%s' "$n"; return; }
    else printf '%s' "${names[$idx]}"; return; fi
  done
}

accounts_menu(){
  local names=() n idx
  while :; do
    names=(); MENU_ITEMS=(); MENU_NOTES=()
    while IFS= read -r n; do [ -n "$n" ] && { names+=("$n"); MENU_ITEMS+=("$(printf '%-16s' "$n")"); MENU_NOTES+=("  ${D}$(vc acct_get "$n" scope)  · $([ -f "$ACCTS/$n/token" ] && echo token || echo 'browser sign-in')${R}"); }; done < <(vc accounts)
    MENU_ITEMS+=("+ add an account" "← back"); MENU_NOTES+=("" "")
    step "Accounts"
    idx="$(menu_pick "Which account" 0)"
    if   [ "$idx" -eq $(( ${#names[@]} + 1 )) ]; then return
    elif [ "$idx" -eq ${#names[@]} ]; then add_account >/dev/null; continue; fi
    n="${names[$idx]}"
    MENU_ITEMS=("remove it" "← back"); MENU_NOTES=("  ${D}forgets the sign-in on this Mac, nothing changes on Vercel${R}" "")
    step "$n"
    [ "$(menu_pick "What to do" 1)" = 0 ] && { vc acct_del "$n"; rm -rf "$ACCTS/$n"; ok "removed “${n}”"; }
  done
}

# ── projects ──────────────────────────────────────────────────────────────
wake_logins(){ # browser logins expire; any vercel cli call renews them, so nudge the expired ones first
  local n
  while IFS= read -r n; do
    [ -n "$n" ] && vercel whoami --global-config "$ACCTS/$n" >/dev/null 2>&1
  done < <(python3 - "$ACCTS" <<'PY2'
import json, os, sys, time
for n in sorted(os.listdir(sys.argv[1])) if os.path.isdir(sys.argv[1]) else []:
    f = os.path.join(sys.argv[1], n, "auth.json")
    try:
        if json.load(open(f)).get("expiresAt", 0) < time.time() + 120: print(n)
    except Exception: pass
PY2
)
}

refresh(){ # pulls every account's projects into the cache behind a spinner
  local out pid i=0 f='|/-\' n e
  out="$(mktemp -t shipsite-refresh)"
  { wake_logins; vc refresh; } 2>"$out" & pid=$!
  if [ -t 2 ]; then
    while kill -0 "$pid" 2>/dev/null; do printf "\r     ${A}%s${R} ${D}refreshing projects from Vercel…${R}" "${f:$((i++ % 4)):1}" >&2; sleep 0.15; done
    printf "\r\033[K" >&2
  fi
  wait "$pid"
  while IFS=$'\t' read -r n e; do [ -n "$n" ] && warn "“${n}”: ${e} — showing its last known projects"; done <"$out"
  rm -f "$out"
}

choose_folder(){ # $1 folder this project was last built from -> echoes the folder to build now
  local saved="$1" p
  if [ -n "$ROOT" ] && { [ -z "$saved" ] || [ "$saved" = "$ROOT" ] || [ ! -d "$saved" ]; }; then printf '%s' "$ROOT"; return; fi
  if [ -n "$ROOT" ]; then
    MENU_ITEMS=("this folder" "the folder it was built from last time"); MENU_NOTES=("  ${D}${ROOT}${R}" "  ${D}${saved}${R}")
    step "Which folder to build"
    [ "$(menu_pick "Build" 0)" = 0 ] && printf '%s' "$ROOT" || printf '%s' "$saved"; return
  fi
  [ -n "$saved" ] && [ -f "$saved/package.json" ] && { printf '%s' "$saved"; return; }
  step "Which folder to build"
  while :; do
    p="$(ask "Project folder" "")"; [ -n "$p" ] || return 1; p="${p/#\~/$HOME}"
    [ -f "$p/package.json" ] && { ( cd "$p" && pwd ); return; }
    warn "no package.json in $p"
  done
}

new_project(){ # -> echoes "account<TAB>id<TAB>name" of a project created by name
  local names=() n acct token team pname r
  while IFS= read -r n; do [ -n "$n" ] && names+=("$n"); done < <(vc accounts)
  if [ ${#names[@]} -eq 1 ]; then acct="${names[0]}"; else acct="$(pick_account)" || return 1; fi
  token="$(acct_token "$acct")"; team="$(vc acct_get "$acct" team_id)"
  step "New Vercel project in “${acct}”  ${D}$(vc acct_get "$acct" scope)${R}"
  n=""; [ -n "$ROOT" ] && n="$(slugify "$(node -p "require('$ROOT/package.json').name||''" 2>/dev/null || basename "$ROOT")")"
  while :; do
    pname="$(ask "Project name" "$n")"; [ -n "$pname" ] || return 1
    pname="$(slugify "$pname")"
    [ "$DRY" = yes ] && { ok "would create “${pname}” in “${acct}”  ${D}(dry run, not created)${R}"; return 1; }
    r="$(vc create "$token" "${team:--}" "$pname")" && break
    warn "${r#ERR	}"
  done
  ok "created “${r#*	}”"
  vc cache_add "$acct" "${r%%	*}" "${r#*	}" "${r#*	}.vercel.app"
  printf '%s\t%s' "$acct" "$r"
}

find_root(){ local d="$PWD"; while [ "$d" != "/" ]; do [ -f "$d/package.json" ] && { printf '%s' "$d"; return; }; d="$(dirname "$d")"; done; return 1; }
detect_pm(){ # $1 root -> the package manager whose lockfile is there, npm otherwise
  if   [ -f "$1/pnpm-lock.yaml" ]; then echo pnpm
  elif [ -f "$1/yarn.lock" ];      then echo yarn
  elif [ -f "$1/bun.lock" ] || [ -f "$1/bun.lockb" ]; then echo bun
  else echo npm; fi
}
slugify(){ printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//'; }
stage_dist(){ # $1 root  $2 stage dir  $3 project id  $4 org id  $5 project name
  cp -R "$1/dist/." "$2/" || return 1
  [ -f "$1/vercel.json" ] && cp "$1/vercel.json" "$2/vercel.json"
  [ -f "$2/vercel.json" ] || printf '{"rewrites":[{"source":"/(.*)","destination":"/index.html"}]}' > "$2/vercel.json"
  mkdir -p "$2/.vercel"
  printf '{"projectId":"%s","orgId":"%s","projectName":"%s"}' "$3" "$4" "$5" > "$2/.vercel/project.json"
}

bump_version(){ # $1 version like 1.4.2+17  $2 build|patch|minor|major -> next version
  local name="${1%%+*}" build="" ma mi pa
  name="${name%%-*}"   # a pre-release tag (1.0.0-beta.1) is dropped: bumping moves past it
  case "$1" in *+*) build="${1#*+}" ;; esac
  IFS=. read -r ma mi pa <<<"$name"; ma="${ma:-0}"; mi="${mi:-0}"; pa="${pa:-0}"
  case "$2" in
    patch) pa=$((pa + 1)) ;;
    minor) mi=$((mi + 1)); pa=0 ;;
    major) ma=$((ma + 1)); mi=0; pa=0 ;;
  esac
  case "$build" in ''|*[!0-9]*) [ "$2" = build ] && build=1 ;; *) build=$((build + 1)) ;; esac
  printf '%s%s' "$ma.$mi.$pa" "${build:++$build}"
}

web_version_guard(){ # $1 root -> on a main-website publish, shows the version and bumps package.json only if asked
  local root="$1" v nv repeat=no
  v="$(node -p "require('$root/package.json').version||''" 2>/dev/null)"
  # package.json is plain semver (1.0.0, maybe 1.0.0-beta.1); anything else is left alone
  echo "$v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$' || return 0
  [ "$v" = "$(vc proj_get "$root" last_prod_version)" ] && repeat=yes
  step "Version  ${B}$v${R}$([ "$repeat" = yes ] && printf "  ${Y}live already${R}")"
  MENU_ITEMS=("publish as $v" "bump"); MENU_NOTES=("" "  ${D}next is $(bump_version "$v" patch), or type your own${R}")
  [ "$(menu_pick "Version" "$([ "$repeat" = yes ] && echo 1 || echo 0)")" = 0 ] && return 0
  while :; do
    nv="$(ask "New version" "$(bump_version "$v" patch)")"
    echo "$nv" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$' && break
    warn "“${nv}” is not a version like 1.0.1"
  done
  [ "$nv" = "$v" ] && return 0
  [ "$DRY" = yes ] && { row "package" "would become version: ${D}$v${R} → ${B}$nv${R}  ${D}(dry run, not written)${R}"; return 0; }
  cmd "npm version $nv --no-git-tag-version"
  ( cd "$root" && npm version "$nv" --no-git-tag-version >/dev/null ) || { warn "could not bump package.json — publishing $v"; return 0; }
  row "package" "version: ${D}$v${R} → ${B}$nv${R}"
}

dry_deploy(){ # $1 account $2 project id $3 project name $4 folder $5 package manager -> checks, then what would run; changes nothing
  local acct="$1" pid="$2" pname="$3" root="$4" pm="$5" token team r bad=0
  token="$(acct_token "$acct")"; team="$(vc acct_get "$acct" team_id)"
  step "Dry run · checks"
  [ -n "$(node -p "(require('$root/package.json').scripts||{}).build||''" 2>/dev/null)" ] \
    && ok "package.json has a build script" || { warn "✗ package.json has no build script"; bad=1; }
  have "$pm" && ok "$pm is installed" || { warn "✗ $pm is not installed"; bad=1; }
  r="$(vc user "$token" 2>/dev/null)" && ok "Vercel login works  ${D}${r#*	} · ${acct}${R}" || { warn "✗ Vercel login failed for “${acct}”: ${r#ERR	}"; bad=1; }
  r="$(vc domain "$token" "${team:--}" "$pid" 2>/dev/null)" && ok "project “${pname}” is reachable" || { warn "✗ cannot reach project “${pname}”: ${r#ERR	}"; bad=1; }

  step "Dry run · would run"
  cmd "cd $root && $pm run build"
  acct_cli "$acct"
  cmd "vercel deploy --yes $([ "$PROD" = yes ] && echo --prod) $([ "${AUTH[0]}" = --token ] && echo '--token ••••' || printf '%s "%s"' "${AUTH[0]}" "${AUTH[1]}")  ${D}(from a temp copy of dist/)${R}"
  row "target" "$([ "$PROD" = yes ] && echo 'main website' || echo 'test version')"
  printf "\n" >&2
  [ "$bad" = 0 ] && ok "dry run passed — nothing was built, deployed or written" \
                 || warn "dry run found problems above — nothing was built, deployed or written"
  printf "\n" >&2
}

# ── deploy ────────────────────────────────────────────────────────────────
deploy(){ # $1 account  $2 project id  $3 project name  $4 folder
  local acct="$1" pid="$2" pname="$3" root="$4" pm token team stage url flag domain log
  [ -f "$root/package.json" ] || die "no package.json in $root"
  pm="$(detect_pm "$root")"
  vc proj_set "$root" account "$acct"; vc proj_set "$root" id "$pid"; vc proj_set "$root" name "$pname"
  token="$(acct_token "$acct")"; team="$(vc acct_get "$acct" team_id)"

  step "$pname"
  row "account" "$acct  ${D}$(vc acct_get "$acct" scope)${R}"
  row "folder" "$root"
  if [ -z "$PROD" ]; then
    MENU_ITEMS=("main website" "test version"); MENU_NOTES=("   ${D}updates production${R}" "   ${D}a new preview URL, production untouched${R}")
    [ "$(menu_pick "Publish to" 0)" = 0 ] && PROD=yes || PROD=no
  fi
  [ "$PROD" = yes ] && web_version_guard "$root"

  [ "$DRY" = yes ] && { dry_deploy "$acct" "$pid" "$pname" "$root" "$pm"; exit 0; }

  stage="$(mktemp -d -t shipsite)"; trap "rm -rf '$stage' '$stage'-*.log" EXIT
  step "Building"
  cmd "cd $root && $pm run build"
  log="$stage-build.log"
  ( cd "$root" && $pm run build ) > >(tee "$log" >&2) 2>&1 || { fail "the build failed — nothing was published" "$log"; }
  [ -f "$root/dist/index.html" ] || die "no dist/index.html after the build — is the Vite outDir something else?"

  # publish from a copy outside the repo: no .git above it, so Vercel attaches no commit
  stage_dist "$root" "$stage" "$pid" "$(vc acct_get "$acct" org_id)" "$pname" || die "could not copy dist/"

  step "Publishing"
  row "project" "$pname"
  row "target" "$([ "$PROD" = yes ] && echo 'main website' || echo 'test version')"
  [ "$PROD" = yes ] && flag="--prod" || flag=""
  acct_cli "$acct"
  cmd "vercel deploy --yes $flag $([ "${AUTH[0]}" = --token ] && echo '--token ••••' || printf '%s "%s"' "${AUTH[0]}" "${AUTH[1]}")  ${D}(from a temp copy of dist/)${R}"
  log="$stage-deploy.log"
  url="$(cd "$stage" && vercel deploy --yes $flag "${AUTH[@]}" 2> >(tee "$log" >&2))" || fail "Vercel rejected the deploy — nothing was published" "$log"
  [ -n "$url" ] || fail "Vercel finished but returned no URL" "$log"
  if [ "$PROD" = yes ]; then
    domain="$(vc domain "$token" "${team:--}" "$pid" 2>/dev/null)"; [ -n "$domain" ] && [ "${domain#ERR}" = "$domain" ] && url="https://$domain"
  fi
  if [ "$PROD" = yes ]; then
    vc proj_set "$root" last_prod_version "$(node -p "require('$root/package.json').version||''" 2>/dev/null)"
    vc proj_set "$root" last_prod_date "$(date '+%d %b %H:%M')"
  fi
  printf %s "$url" | pbcopy 2>/dev/null
  step "Published"
  row "link" "${B}${A}${url}${R}  ${D}copied${R}"
  printf "\n" >&2
}

# ── main ──────────────────────────────────────────────────────────────────
PROD=""; ROOT=""; DRY=no
main(){
  local arg rows=() a id nm u f note sel idx r folder
  for arg in "$@"; do
    case "$arg" in
      --prod|--production) PROD=yes ;;
      --preview)           PROD=no ;;
      --dry-run|-n)        DRY=yes ;;
      accounts)            [ -t 0 ] || die "needs a terminal"; banner "ship-site $VERSION" "accounts"; accounts_menu; exit 0 ;;
      --version|-V|-v)     echo "ship-site $VERSION"; exit 0 ;;
      -h|--help)
        printf "\n  ${B}ship-site${R} ${D}%s${R}\n\n" "$VERSION"
        printf "    ${A}ship-site${R}             your Vercel projects; pick one, it builds and publishes\n"
        printf "    ${A}ship-site --prod${R}      straight to the main website, no question asked\n"
        printf "    ${A}ship-site --preview${R}   a fresh preview URL\n"
        printf "    ${A}ship-site --dry-run${R}   check everything and show what would happen; changes nothing (also -n)\n"
        printf "    ${A}ship-site ~/site${R}      treat that folder as the current project\n"
        printf "    ${A}ship-site accounts${R}    add or remove Vercel accounts\n\n"
        printf "  ${D}Run inside a Vite project and its Vercel project is preselected. Settings live in %s${R}\n\n" "$CONF"
        exit 0 ;;
      *) ROOT="${arg/#\~/$HOME}"; [ -f "$ROOT/package.json" ] || die "no package.json in $ROOT" ;;
    esac
  done
  [ -t 0 ] || die "ship-site needs a terminal — run it, do not pipe into it"
  have python3 || die "python3 is required (it ships with macOS developer tools)"
  need(){ # $1 what  $2 how to check  $3 install command -> asks, installs, or dies with the command
    have "$2" && return
    printf "     ${Y}!${R} %s is not installed\n     ${A}Install it now with  %s${R} ${D}(y/n) [yes]${R} ${A}›${R} " "$1" "$3" >&2
    read -r a; case "$a" in [nN]*) die "install it yourself, then run again:  $3" ;; esac
    $3 >&2 || die "that failed — run it yourself and try again:  $3"
    have "$2" || die "$1 still not found — open a new terminal and run again"
  }
  have brew && need "node and npm" npm "brew install node" || have npm || die "node is required — install it from https://nodejs.org then run again"
  need "the Vercel CLI" vercel "npm i -g vercel"
  [ -n "$ROOT" ] || ROOT="$(find_root)" || ROOT=""
  [ -n "$ROOT" ] && ROOT="$(cd "$ROOT" && pwd)"

  banner "ship-site $VERSION" "build it, publish it, copy the link"
  [ "$DRY" = yes ] && sub "${Y}dry run — checks everything, then shows what it would do; nothing is built, deployed, created or written${R}"
  [ -n "$(vc accounts)" ] || { step "No Vercel account on this Mac yet"; add_account >/dev/null || die "no account added"; }
  refresh

  while :; do
    rows=(); MENU_ITEMS=(); MENU_NOTES=(); sel=0
    while IFS=$'\t' read -r a id nm u f; do
      [ -n "$id" ] || continue
      rows+=("$a	$id	$nm	$f")
      note=""
      if [ -n "$ROOT" ] && [ "$f" = "$ROOT" ]; then note="  ${G}● this folder${R}"; sel=$(( ${#rows[@]} - 1 ))
      elif [ -n "$f" ]; then note="  ${D}$(sed "s|^$HOME|~|" <<<"$f")${R}"; fi
      MENU_ITEMS+=("$(printf '%-24s' "$nm")"); MENU_NOTES+=("  ${D}$(printf '%-16s %-34s' "$a" "$u")${R}$note")
    done < <(vc landing)
    MENU_ITEMS+=("+ new project" "accounts" "refresh" "quit")
    MENU_NOTES+=("  ${D}create one on Vercel by name${R}" "  ${D}add, remove, sign in again${R}" "  ${D}fetch the project list again${R}" "")
    step "Projects"
    [ -n "$ROOT" ] && sub "you are in $(sed "s|^$HOME|~|" <<<"$ROOT")"
    idx="$(menu_pick "Pick one to publish" "$sel")"
    case $(( idx - ${#rows[@]} )) in
      0) r="$(new_project)" || continue
         folder="$(choose_folder "")" || continue
         deploy "${r%%	*}" "$(cut -f2 <<<"$r")" "$(cut -f3 <<<"$r")" "$folder"; exit 0 ;;
      1) accounts_menu; refresh; continue ;;
      2) refresh; continue ;;
      3) printf "\n" >&2; exit 0 ;;
    esac
    IFS=$'\t' read -r a id nm f <<<"${rows[$idx]}"
    folder="$(choose_folder "$f")" || continue
    deploy "$a" "$id" "$nm" "$folder"; exit 0
  done
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
