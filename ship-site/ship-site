#!/usr/bin/env bash
# ship-site: build a Vite site, publish only the dist folder to Vercel, copy the link.
#
# One file. The Vercel CLI does the auth, the upload and the project linking;
# this script only remembers which Vercel project each folder belongs to, in
# ~/.config/ship-site, so a fresh dist/ never creates a project by accident.
#
# Needs node and the Vercel CLI; it asks before installing either one that is missing.
#
# License: MIT.

set -uo pipefail

# ── looks ─────────────────────────────────────────────────────────────────
if [ -t 2 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  B=$(tput bold); D=$(tput dim); R=$(tput sgr0)
  A=$(tput setaf 6); G=$(tput setaf 2); Y=$(tput setaf 3); E=$(tput setaf 1)
else B=; D=; R=; A=; G=; Y=; E=; fi
VERSION="1.0.1"
banner(){ printf "\n  ${A}${B}◆  %s${R}  ${D}%s${R}\n" "$1" "${2:-}" >&2; }
step(){ printf "\n  ${A}${B}▸${R} ${B}%s${R}\n" "$1" >&2; }
ok(){ printf "     ${G}✓${R} %s\n" "$1" >&2; }
die(){ printf "\n  ${E}${B}✗ %s${R}\n" "$1" >&2; exit 1; }
row(){ printf "     ${D}%-11s${R} %s\n" "$1" "$2" >&2; }
have(){ command -v "$1" >/dev/null 2>&1; }

CONF="$HOME/.config/ship-site"

menu_pick(){ # $1 title, rest items -> echoes chosen index. ↑↓ or j/k move, Enter picks
  local title="$1"; shift
  local items=("$@") n=$# sel=0 k rest i saved
  saved="$(stty -g 2>/dev/null || true)"
  [ -n "$saved" ] && { stty -echo -icanon 2>/dev/null; trap 'stty "$saved" 2>/dev/null; exit 130' INT; }
  printf "     ${D}%s  · ↑↓ move · Enter picks${R}\n" "$title" >&2
  for ((i=0;i<n;i++)); do printf '\n' >&2; done
  while :; do
    printf "\033[%dA" "$n" >&2
    for ((i=0;i<n;i++)); do
      [ "$i" -eq "$sel" ] && printf "\r\033[K     ${A}❯ %s${R}\n" "${items[$i]}" >&2 \
                          || printf "\r\033[K       ${D}%s${R}\n" "${items[$i]}" >&2
    done
    IFS= read -rsn1 k 2>/dev/null || break
    case "$k" in
      '')    break ;;
      $'\e') IFS= read -rsn2 rest 2>/dev/null || rest=""
             case "$rest" in "[A") sel=$(((sel-1+n)%n)) ;; "[B") sel=$(((sel+1)%n)) ;; esac ;;
      k|K)   sel=$(((sel-1+n)%n)) ;;
      j|J)   sel=$(((sel+1)%n)) ;;
    esac
  done
  [ -n "$saved" ] && { trap - INT; stty "$saved" 2>/dev/null; }
  printf '%s' "$sel"
}

find_root(){ # walk up from $PWD until a package.json shows up
  local d="$PWD"
  while [ "$d" != "/" ]; do [ -f "$d/package.json" ] && { printf '%s' "$d"; return; }; d="$(dirname "$d")"; done
  return 1
}

main(){
  local PROD="" ROOT="" arg name slug pm dist link flag url
  for arg in "$@"; do
    case "$arg" in
      --prod|--production) PROD=yes ;;
      --preview)           PROD=no ;;
      --version|-V)        echo "ship-site $VERSION"; exit 0 ;;
      -h|--help)
        printf "\n  ${B}ship-site${R} ${D}%s${R}\n\n" "$VERSION"
        printf "    ${A}ship-site${R}             build this Vite project and publish dist/ to Vercel\n"
        printf "    ${A}ship-site --prod${R}      straight to the main website, no question asked\n"
        printf "    ${A}ship-site --preview${R}   a fresh preview URL\n"
        printf "    ${A}ship-site ~/site${R}      a project folder other than the current one\n\n"
        printf "  ${D}First run per project asks Vercel to link or create it; later runs remember.\n"
        printf "  Links live in %s${R}\n\n" "$CONF"
        exit 0 ;;
      *) ROOT="${arg/#\~/$HOME}" ;;
    esac
  done
  [ -t 0 ] || die "ship-site needs a terminal — run it, do not pipe into it"
  need(){ # $1 what  $2 how to check  $3 install command -> asks, installs, or dies with the command
    have "$2" && return
    printf "     ${Y}!${R} %s is not installed\n     ${A}Install it now with  %s${R} ${D}(y/n) [yes]${R} ${A}›${R} " "$1" "$3" >&2
    read -r a; case "$a" in [nN]*) die "install it yourself, then run again:  $3" ;; esac
    $3 >&2 || die "that failed — run it yourself and try again:  $3"
    have "$2" || die "$1 still not found — open a new terminal and run again"
  }
  have brew && need "node and npm" npm "brew install node" || have npm || die "node is required — install it from https://nodejs.org then run again"
  need "the Vercel CLI" vercel "npm i -g vercel"
  [ -n "$ROOT" ] || ROOT="$(find_root)" || die "no package.json here — run it inside a Vite project or pass the folder"
  ROOT="$(cd "$ROOT" && pwd)"
  [ -f "$ROOT/package.json" ] || die "no package.json in $ROOT"
  name="$(node -p "require('$ROOT/package.json').name||''" 2>/dev/null)"; name="${name:-$(basename "$ROOT")}"
  slug="$(printf '%s' "$name" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')"
  if   [ -f "$ROOT/pnpm-lock.yaml" ]; then pm=pnpm
  elif [ -f "$ROOT/yarn.lock" ];      then pm=yarn
  elif [ -f "$ROOT/bun.lock" ] || [ -f "$ROOT/bun.lockb" ]; then pm=bun
  else pm=npm; fi
  dist="$ROOT/dist"

  banner "ship-site $VERSION" "build it, publish it, copy the link"
  step "Project"
  row "folder" "$ROOT"
  row "name" "$name"
  row "build" "$pm run build"

  if [ -z "$PROD" ]; then
    step "Where"
    [ "$(menu_pick "Publish to" "main website   — updates production" "test version   — a new preview URL")" = 0 ] && PROD=yes || PROD=no
  fi
  vercel whoami >/dev/null 2>&1 || { step "Sign in to Vercel"; vercel login >&2 || die "not signed in"; }

  step "Building"
  ( cd "$ROOT" && $pm run build ) >&2 || die "the build failed — nothing was published"
  [ -f "$dist/index.html" ] || die "no dist/index.html after the build — is the Vite outDir something else?"

  step "Publishing"
  # vercel keeps its project link in <dir>/.vercel; vite wipes dist/ each build,
  # so stash the link in CONF and put it back before every deploy.
  link="$CONF/$slug.json"; mkdir -p "$CONF" "$dist/.vercel"
  if [ -f "$link" ]; then cp "$link" "$dist/.vercel/project.json"
  else ( cd "$dist" && vercel link --project "$slug" --yes ) >&2 || die "could not link a Vercel project"; fi
  cp "$dist/.vercel/project.json" "$link"
  if [ -f "$ROOT/vercel.json" ]; then cp "$ROOT/vercel.json" "$dist/vercel.json"
  elif [ ! -f "$dist/vercel.json" ]; then printf '{"rewrites":[{"source":"/(.*)","destination":"/index.html"}]}' > "$dist/vercel.json"; fi

  [ "$PROD" = yes ] && flag=--prod || flag=""
  url="$(cd "$dist" && vercel deploy --yes $flag)" || die "Vercel rejected the deploy — see the output above"
  [ "$PROD" = yes ] && url="https://$(node -p "require('$link').projectName").vercel.app"   # ponytail: stable URL = <project>.vercel.app; custom domains show in vercel's own output above
  printf %s "$url" | pbcopy 2>/dev/null
  step "Published"
  row "target" "$([ "$PROD" = yes ] && echo 'main website' || echo 'test version')"
  row "link" "${B}${A}${url}${R}  ${D}copied${R}"
  printf "\n" >&2
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
