#!/usr/bin/env bash
# developer-tools: the hub. Run any tool online, or install, update and remove them.
#
#   bash <(curl -fsSL https://raw.githubusercontent.com/azharbinanwar/developer-tools/main/developer-tools)
#
# Each tool is also a standalone command (ship-apk, ship-site). Running one from
# here uses the installed copy if there is one, otherwise the latest release
# straight from GitHub, so the hub works with nothing installed.
#
# License: MIT.
#
# Built by ./build from lib/*.sh and hub/main.sh — edit those, then run ./build; this file is the result.

set -uo pipefail

# ── platform ─────────────────────────────────────────────────────────────
# ── platform ──────────────────────────────────────────────────────────────
# macOS, Linux and Windows (Git Bash or WSL) differ in a few commands; everything platform-specific goes through these.
case "$(uname -s 2>/dev/null)" in Darwin) OS=mac ;; MINGW*|MSYS*|CYGWIN*) OS=windows ;; *) OS=linux ;; esac
PY=python3; command -v python3 >/dev/null 2>&1 || PY=python
py(){ "$PY" "$@"; }
clip(){ # stdin -> the clipboard, whichever tool this machine has; false when there is none
  if command -v pbcopy >/dev/null 2>&1; then pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then wl-copy
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then xsel --clipboard --input
  elif command -v clip.exe >/dev/null 2>&1; then clip.exe
  else cat >/dev/null; return 1; fi
}
open_it(){ # $1 file, folder or url -> opens it with the desktop; false when nothing can
  if [ "$OS" = mac ]; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1
  elif command -v wslview >/dev/null 2>&1; then wslview "$1"
  elif command -v cmd.exe >/dev/null 2>&1; then cmd.exe /c start "" "$1" >/dev/null 2>&1
  else return 1; fi
}
edit_file(){ # $1 file -> opens it in $VISUAL/$EDITOR, else the desktop's text editor; waits only for a terminal editor
  if [ -n "${VISUAL:-${EDITOR:-}}" ]; then
    if [ -t 2 ]; then ${VISUAL:-$EDITOR} "$1" </dev/tty >/dev/tty; else ${VISUAL:-$EDITOR} "$1" >&2; fi; return 0
  fi
  if [ "$OS" = mac ]; then open -t "$1"; else open_it "$1"; fi || return 1
  printf "     ${A}Opened in your editor — save it, then press Enter here${R} ${A}›${R} " >&2; read -r _
}
# BSD (macOS) and GNU (Linux, Git Bash) stat and date take different flags, and GNU accepts the BSD ones with other
# meanings (stat -f is file-system info), so these branch on OS rather than on failure
fsize(){ if [ "$OS" = mac ]; then stat -f %z "$1"; else stat -c %s "$1"; fi; }        # bytes
fmtime(){ if [ "$OS" = mac ]; then stat -f %m "$1"; else stat -c %Y "$1"; fi; }       # seconds since the epoch
fmode(){ if [ "$OS" = mac ]; then stat -f %Lp "$1"; else stat -c %a "$1"; fi; }       # permission bits, e.g. 600
fdate(){ if [ "$OS" = mac ]; then date -r "$1" "$2"; else date -d "@$1" "$2"; fi; }   # $1 epoch seconds  $2 format
sed_i(){ if sed --version >/dev/null 2>&1; then sed -i "$@"; else sed -i '' "$@"; fi; }
tmpf(){ mktemp "${TMPDIR:-/tmp}/${1:-tmp}.XXXXXX"; }              # a temp file; portable, no -t
tmpd(){ mktemp -d "${TMPDIR:-/tmp}/${1:-tmp}.XXXXXX"; }           # a temp folder
RULE="────────────────────────────────────────────"

# ── looks ─────────────────────────────────────────────────────────────────
# ── looks ─────────────────────────────────────────────────────────────────
if [ -t 2 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  B=$(tput bold); D=$(tput dim); R=$(tput sgr0)
  A=$(tput setaf 6); G=$(tput setaf 2); Y=$(tput setaf 3); E=$(tput setaf 1)
else B=; D=; R=; A=; G=; Y=; E=; fi
banner(){ printf "\n  ${A}${B}◆  %s${R}  ${D}%s${R}\n" "$1" "${2:-}" >&2; }
step(){ printf "\n  ${A}${B}▸${R} ${B}%s${R}\n" "$1" >&2; }
sub(){ printf "     ${D}%s${R}\n" "$1" >&2; }
ok(){ printf "     ${G}✓${R} %s\n" "$1" >&2; }
warn(){ printf "     ${Y}!${R} %s\n" "$1" >&2; }
die(){ printf "\n  ${E}${B}✗ %s${R}\n" "$1" >&2; exit 1; }
row(){ printf "     ${D}%-11s${R} %s\n" "$1" "$2" >&2; }
cmd(){ printf "     ${D}\$${R} %s\n" "$1" >&2; }
have(){ command -v "$1" >/dev/null 2>&1; }
fail(){ # $1 message  $2 log file -> repeats the error lines from the log, then dies
  local l; printf "\n" >&2
  warn "$1"
  grep -i 'error\|fail\|denied\|not found\|cannot' "$2" 2>/dev/null | tail -6 | while IFS= read -r l; do sub "$l"; done
  die "stopped — full output is above"
}


fit(){ # $1 text (may carry colour codes)  $2 width -> the text as is, or cut with … when it would wrap
  local plain
  plain="$(printf '%s' "$1" | sed -e $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' -e $'s/\x1b(B//g')"
  [ "${#plain}" -le "$2" ] && { printf '%s' "$1"; return; }
  printf '%s…' "${plain:0:$(( $2 - 1 ))}"
}
term_size(){ # -> "rows cols" of the real terminal; works inside $( ), where tput only sees a pipe and guesses 24x80
  local s; s="$({ stty size </dev/tty; } 2>/dev/null)"
  [ -n "$s" ] && { printf '%s' "$s"; return; }
  printf '%s %s' "$(tput lines 2>/dev/null || echo 24)" "$(tput cols 2>/dev/null || echo 80)"
}
MENU_ITEMS=(); MENU_NOTES=(); MENU_FIXED=0
menu_pick(){ # $1 title  [$2 skip index]  $3 start index -> echoes chosen index
  # items starting with \x01 are headings, never picked; the last MENU_FIXED items stay on screen while the rest scrolls.
  # With a skip index, Esc, q and end of input pick that row (a "skip" or "back" row); without one, Esc and end of input
  # pick the "← back" row when there is one, and q quits.
  local title="$1" skip=-1 n=${#MENU_ITEMS[@]} sel k rest i saved step nf ns vs top=0 last L ctxl=0 lines cols w g ctx more
  if [ $# -ge 3 ]; then skip="$2"; sel="$3"; else sel="$2"; fi
  nf=${MENU_FIXED:-0}; MENU_FIXED=0; ns=$((n - nf))
  read -r lines cols <<<"$(term_size)"
  vs=$(( lines - 9 - nf )); [ "$vs" -lt 3 ] && vs=3; [ "$vs" -gt "$ns" ] && vs=$ns
  [ "$ns" -gt "$vs" ] && ctxl=1      # a scrolling list gets one line on top for its group heading
  L=$((ctxl + vs + nf))
  saved="$(stty -g 2>/dev/null || true)"
  printf '\033[?7l' >&2   # no wrapping while the menu is up: a long row is cut, not wrapped, so the redraw stays aligned
  [ -n "$saved" ] && { stty -echo -icanon 2>/dev/null; trap 'stty "$saved" 2>/dev/null; printf "\033[?7h" >&2; exit 130' INT; }
  menu_keys
  printf "     ${D}%s  · ↑↓ move · Enter or a [key] picks · Esc back · q quits${R}\n" "$title" >&2
  for ((i=0;i<L;i++)); do printf '\n' >&2; done
  # rows are cut to the window width up front: a wrapped row would throw off the cursor-up redraw
  local rows=() hit; w=$(( cols - 20 ))
  for ((i=0;i<n;i++)); do
    if [ "${MENU_ITEMS[$i]:0:1}" = $'\x01' ]; then rows+=("$(fit "${MENU_ITEMS[$i]}" "$w")")
    else rows+=("$(fit "$(pfx "$i")${MENU_ITEMS[$i]}${MENU_NOTES[$i]:-}" "$w")"); fi
  done
  is_head(){ [ "${MENU_ITEMS[$1]:0:1}" = $'\x01' ]; }
  while is_head "$sel"; do sel=$(((sel+1)%n)); done
  while :; do
    if [ "$sel" -lt "$ns" ]; then
      [ "$sel" -lt "$top" ] && top=$sel
      [ "$sel" -ge $((top + vs)) ] && top=$((sel - vs + 1))
      [ "$top" -gt 0 ] && is_head $((top - 1)) && [ "$sel" -lt $((top + vs - 1)) ] && top=$((top - 1))
    fi
    last=$((top + vs - 1))
    printf "\033[%dA" "$L" >&2
    if [ "$ctxl" = 1 ]; then
      # the heading of the group in view, pinned when it has scrolled off the top
      ctx=""; g=$([ "$sel" -lt "$ns" ] && echo "$sel" || echo "$top")
      while [ "$g" -ge 0 ] && { ! is_head "$g" || [ "${MENU_ITEMS[$g]:1:1}" = " " ]; }; do g=$((g - 1)); done
      [ "$g" -ge 0 ] && [ "$g" -lt "$top" ] && ctx="${rows[$g]:1}"
      printf "\r\033[K     ${B}%s${R}%s\n" "$ctx" "$([ "$top" -gt 0 ] && printf "  ${D}▲ %s more${R}" "$top")" >&2
    fi
    for ((i=top;i<=last && i<ns;i++)); do
      more=""; [ "$i" -eq "$last" ] && [ "$last" -lt $((ns - 1)) ] && more="  ${D}▼ $((ns - 1 - last)) more${R}"
      if   is_head "$i";           then printf "\r\033[K     ${B}%s${R}%s\n" "${rows[$i]:1}" "$more" >&2
      elif [ "$i" -eq "$sel" ];    then printf "\r\033[K     ${A}❯ %s${R}%s\n" "${rows[$i]}" "$more" >&2
      else                              printf "\r\033[K       ${D}%s${R}%s\n" "${rows[$i]}" "$more" >&2; fi
    done
    for ((i=ns;i<n;i++)); do
      if   is_head "$i";           then printf "\r\033[K     ${B}%s${R}\n" "${rows[$i]:1}" >&2
      elif [ "$i" -eq "$sel" ];    then printf "\r\033[K     ${A}❯ %s${R}\n" "${rows[$i]}" >&2
      else                              printf "\r\033[K       ${D}%s${R}\n" "${rows[$i]}" >&2; fi
    done
    IFS= read -rsn1 k 2>/dev/null || { if [ "$skip" -ge 0 ]; then sel="$skip"; else hit="$(back_hit)" && sel=$hit; fi; break; }   # end of input: back out
    step=0
    hit="$(key_hit "$k")" && { sel=$hit; break; }
    case "$k" in
      '')    break ;;
      $'\e') IFS= read -rsn2 -t 1 rest 2>/dev/null || rest=""
             if [ -z "$rest" ]; then
               if [ "$skip" -ge 0 ]; then sel="$skip"; break; fi
               hit="$(back_hit)" && { sel=$hit; break; }
             fi
             case "$rest" in "[A") step=-1 ;; "[B") step=1 ;; esac ;;
      k|K)   step=-1 ;;
      j|J)   step=1 ;;
      q|Q)   [ "$skip" -ge 0 ] && { sel="$skip"; break; }
             [ -n "$saved" ] && stty "$saved" 2>/dev/null; printf '\033[?7h\n' >&2; exit 0 ;;
    esac
    [ "$step" -ne 0 ] && { sel=$(((sel+step+n)%n)); while is_head "$sel"; do sel=$(((sel+step+n)%n)); done; }
  done
  printf '\033[?7h' >&2
  [ -n "$saved" ] && { trap - INT; stty "$saved" 2>/dev/null; }
  printf '%s' "$sel"
}
ask(){ local r; printf "     ${A}%s${R}%s ${A}›${R} " "$1" "${2:+ ${D}[$2]${R}}" >&2; read -r r; printf '%s' "${r:-$2}"; }
ask_secret(){ # $1 label  $2 saved value -> one * per character typed; Enter on nothing keeps the saved value
  local r="" c
  printf "     ${A}%s${R} ${D}[%s]${R} ${A}›${R} " "$1" "$([ -n "${2:-}" ] && echo 'saved · Enter keeps it' || echo 'none')" >&2
  while IFS= read -rsn1 c; do
    case "$c" in
      '')            break ;;
      $'\177'|$'\b') [ -n "$r" ] && { r="${r%?}"; printf '\b \b' >&2; } ;;
      *)             r="$r$c"; printf '*' >&2 ;;
    esac
  done
  printf '\n' >&2
  printf '%s' "${r:-${2:-}}"
}

ask_yn(){ local r d; [ "$2" = true ] && d="yes" || d="no"
  printf "     ${A}%s${R} ${D}(y/n) [%s]${R} ${A}›${R} " "$1" "$d" >&2
  read -r r; case "$r" in [yY]*) echo true ;; [nN]*) echo false ;; *) echo "$2" ;; esac; }
need(){ # $1 what  $2 how to check  $3 install command -> asks, installs, or dies with the command
  have "$2" && return
  printf "     ${Y}!${R} %s is not installed\n     ${A}Install it now with  %s${R} ${D}(y/n) [yes]${R} ${A}›${R} " "$1" "$3" >&2
  read -r a; case "$a" in [nN]*) die "install it yourself, then run again:  $3" ;; esac
  $3 >&2 || die "that failed — run it yourself and try again:  $3"
  have "$2" || die "$1 still not found — open a new terminal and run again"
}
need_vercel(){ need "the Vercel CLI" vercel "npm i -g vercel"; }
need_firebase(){ need "the Firebase CLI" firebase "npm i -g firebase-tools"; }

show_history(){ # $1 key  $2 name  $3 store (cfg|vc) -> every publish of a project, newest first; a row copies its link
  local key="$1" name="$2" store="$3" lines=() dt tm v tg link m idx
  while IFS=$'\t' read -r dt tm v tg link m; do [ -n "$dt" ] && lines+=("$dt"$'\t'"$tm"$'\t'"$v"$'\t'"$tg"$'\t'"$link"$'\t'"$m"); done < <("$store" history "$key")
  step "History  ${B}${name}${R}  ${D}${#lines[@]} publish$([ ${#lines[@]} = 1 ] || echo es)${R}"
  [ ${#lines[@]} -gt 0 ] || { sub "nothing yet — the first publish from this version on is recorded here"; return; }
  while :; do
    MENU_ITEMS=(); MENU_NOTES=()
    for l in "${lines[@]}"; do
      IFS=$'\t' read -r dt tm v tg link m <<<"$l"
      MENU_ITEMS+=("$(printf '%-11s %-5s  %-10s %-5s' "$dt" "$tm" "$v" "$tg")")
      MENU_NOTES+=("  ${D}${link}$([ "${m:-0}" -gt 0 ] && echo "  · mailed to $m")${R}")
    done
    MENU_ITEMS+=("← back"); MENU_NOTES+=("")
    MENU_NOKEY="$(nokey_rows "${#lines[@]}")"
    idx="$(menu_pick "Enter copies the link" "${#lines[@]}" 0)"; MENU_NOKEY=""
    [ "$idx" -lt ${#lines[@]} ] || return 0
    IFS=$'\t' read -r dt tm v tg link m <<<"${lines[$idx]}"
    printf %s "$link" | clip 2>/dev/null && ok "copied ${link}" || sub "$link"
  done
}

# ── shortcut keys ─────────────────────────────────────────────────────────
# Every option is matched by its text to an action with a default key (ACTIONS below). A key set in
# ~/.config/developer-tools/keys.json, e.g. {"site.main": "w"}, wins over the default. Options without
# an action, such as apps and projects, get 1–9 in screen order. Esc picks "← back"; q quits.
KEYS_FILE="$HOME/.config/developer-tools/keys.json"
PICK_FILE="$HOME/.config/developer-tools/.lastpick"   # how the last menu pick was made: key or enter; one file, overwritten
act_of(){ # $1 option text -> "action key" from ACTIONS, or nothing
  local t p a k
  t="$(printf '%s' "$1" | sed -e $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' -e $'s/\x1b(B//g' | tr 'A-Z' 'a-z' \
       | sed -e 's/^[[:space:]]*//' -e 's/^← *//' -e 's/^+ *//' -e 's/[[:space:]]*$//')"
  while IFS='|' read -r p a k; do
    [ -n "$p" ] || continue
    case "$t" in "$p"|"$p "*) printf '%s %s' "$a" "$k"; return ;; esac
  done <<<"$ACTIONS"
}
MK=(); MENU_NOKEY=""   # MENU_NOKEY: indexes of rows that are data (apps, projects, people) — they get 1–9, never an action key
nokey_rows(){ # $1 count -> "0 1 … count-1", or nothing for 0 (seq would count down to -1)
  local i out=""; for ((i=0;i<${1:-0};i++)); do out="$out$i "; done; printf '%s' "${out% }"
}
menu_keys(){ # -> MK: the shortcut shown for each MENU_ITEMS entry (a letter, 1–9, esc, or nothing)
  local i ak a k o ov used=" j k q / ? " d=1 acts=() defs=() all=" " nokey=" $MENU_NOKEY "
  MK=(); ov=""; MENU_NOKEY=""
  [ -f "$KEYS_FILE" ] && ov="$(py -c '
import json, sys
for a, k in json.load(open(sys.argv[1])).items(): print(a + "=" + str(k)[:1].lower())' "$KEYS_FILE" 2>/dev/null)"
  # first pass: every option's action and default key, so a key from keys.json can never steal another option's default
  for ((i=0;i<${#MENU_ITEMS[@]};i++)); do
    a=""; k=""
    case "$nokey" in *" $i "*) ak="" ;; *) [ "${MENU_ITEMS[$i]:0:1}" != $'\x01' ] && ak="$(act_of "${MENU_ITEMS[$i]}")" || ak="" ;; esac
    [ -n "$ak" ] && { a="${ak%% *}"; k="${ak#* }"; }
    acts+=("$a"); defs+=("$k"); [ -n "$k" ] && [ "$k" != esc ] && all="$all$k "
  done
  for ((i=0;i<${#MENU_ITEMS[@]};i++)); do
    a="${acts[$i]}"; k="${defs[$i]}"
    if [ -n "$a" ] && [ "$a" != "-" ] && [ "$k" != esc ]; then
      o="$(printf '%s\n' "$ov" | grep -F "$a=" | head -1 | cut -d= -f2 || true)"
      if [ -n "$o" ] && [ "$o" != "$k" ]; then
        case "$used$all" in *" $o "*) warn "keys.json: “${o}” for ${a} is taken on this screen — keeping “${k}”"; o="" ;; esac
      fi
      [ -n "$o" ] && k="$o"
      case "$used" in *" $k "*) k="" ;; esac
    fi
    [ "$a" = "-" ] && k=""
    [ "$a" = quit ] && k=q          # q quits on every screen anyway; the quit option just shows it
    if [ -z "$a" ] && [ "${MENU_ITEMS[$i]:0:1}" != $'\x01' ] && [ "$d" -le 9 ]; then k="$d"; d=$((d + 1)); fi
    [ -n "$k" ] && [ "$k" != esc ] && used="$used$k "
    MK+=("$k")
  done
  mkdir -p "${PICK_FILE%/*}" 2>/dev/null; printf 'enter' > "$PICK_FILE" 2>/dev/null
}
pfx(){ local k="${MK[$1]:-}"; [ -n "$k" ] && printf '%-6s' "[$k]" || printf '      '; }
key_hit(){ # $1 key pressed -> echoes the index of the option with that shortcut
  local i; [ -n "$1" ] || return 1
  for ((i=0;i<${#MK[@]};i++)); do [ "${MK[$i]}" = "$1" ] && { printf 'key' > "$PICK_FILE" 2>/dev/null; printf '%s' "$i"; return 0; }; done
  return 1
}
back_hit(){ local i; for ((i=0;i<${#MK[@]};i++)); do [ "${MK[$i]}" = esc ] && { printf '%s' "$i"; return 0; }; done; return 1; }
picked_by_key(){ [ "$(cat "$PICK_FILE" 2>/dev/null)" = key ]; }
YES=no   # --yes: every confirmation is taken as y; set by a tool's flags, used by scripts and the web page
confirm_y(){ # $1 question -> true only on y; used where one stray key must not do something hard to undo
  [ "$YES" = yes ] && return 0
  local c; printf "     ${Y}%s${R} ${A}y to go, any other key cancels ›${R} " "$1" >&2
  IFS= read -rsn1 c; printf '%s\n' "$c" >&2
  [ "$c" = y ] || [ "$c" = Y ]
}

# ── web ───────────────────────────────────────────────────────────────────
# developer-tools ui: one local page over the same config files the tools use. Read-only: projects, apps, labels,
# domains, counts, history, recipients and the mailbox, every link copyable. Python's stdlib serves it on 127.0.0.1
# with a random token in the URL, so no other page in the browser can read it; the password never leaves the file.
stop_ui(){ # $1 pid of the wrapper -> the server runs inside it; both go, so the port is freed
  pkill -TERM -P "$1" 2>/dev/null; kill "$1" 2>/dev/null; wait "$1" 2>/dev/null
}
ui_serve(){ # [--no-open] -> runs until q or Ctrl-C
  local tok url pid open=yes line out
  [ "${1:-}" = --no-open ] && open=no
  tok="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  out="$(tmpf devtools-ui)"
  step "Web page"
  # the ship-site that publishes from the page: the one next to this hub (the repo), else the installed one
  local here site_bin=""; here="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
  if [ -x "$here/ship-site/ship-site" ]; then site_bin="$here/ship-site/ship-site"; else site_bin="$(command -v ship-site || true)"; fi
  py - "$HOME/.config" "$tok" "$site_bin" "$VERSION" "$(command -v ship-apk || true)" "${BASH_SOURCE[0]}" <<'PY' >"$out" 2>&1 &
import json, os, re, sys, time, html, subprocess, tempfile, threading
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs

CONF, TOKEN, SHIP_SITE, HUB_VERSION, SHIP_APK, SELF = sys.argv[1:7]
PORT = 0
def page_src():
    """the page as it is in the script on disk right now, so a rebuild shows on the next refresh without a restart"""
    try:
        m = re.search(r'PAGE_B64 = "([A-Za-z0-9+/=]+)"', open(SELF).read())
        return _b64.b64decode(m.group(1)).decode("utf-8") if m else PAGE
    except Exception: return PAGE
def page_hash():
    import hashlib; return hashlib.md5(page_src().encode()).hexdigest()[:12]
def sh(args, cwd=None):
    try: return subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception: return ""
def commits(folder):   # the last few commit titles, for the notes step
    if not folder or not os.path.isdir(os.path.join(folder, ".git")): return []
    return [l for l in sh(["git", "log", "-5", "--format=%s"], folder).splitlines() if l]
def pkg_version(folder):
    try: return json.load(open(os.path.join(folder, "package.json"))).get("version", "")
    except Exception: return ""
def pubspec_version(folder):
    try:
        for l in open(os.path.join(folder, "pubspec.yaml")):
            if l.startswith("version:"): return l.split(":", 1)[1].strip()
    except Exception: pass
    return ""
def tool_version(path):
    v = sh([path, "--version"]) if path else ""
    return v.split()[-1] if v else ""
RUNS, LOCK = {}, threading.Lock()   # publishes started from the page: id -> (process, log file)
def start(body):
    """one ship-site run with every answer given up front; returns the run id or an error"""
    if not SHIP_SITE: return {"error": "ship-site is not installed on this computer"}
    pid, folder = str(body.get("id", "")), str(body.get("folder", ""))
    target, version, notes, mail = body.get("target"), str(body.get("version", "keep")), str(body.get("notes", "-")), bool(body.get("mail"))
    if not pid or target not in ("main", "test"): return {"error": "which project, and main or test?"}
    if version not in ("keep", "next") and not re.match(r"^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$", version): return {"error": "a version like 1.2.3, or keep or next"}
    if target == "test": version = "keep"
    args = [SHIP_SITE, "--project", pid, "--prod" if target == "main" else "--preview", "--version=" + version,
            "--notes", notes or "-", "--mail" if mail else "--no-mail", "--yes"] + (["--dry-run"] if body.get("dry") else []) + ([folder] if folder else [])
    log = tempfile.NamedTemporaryFile(prefix="devtools-run-", suffix=".log", delete=False)
    proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, env=dict(os.environ, TERM="dumb"))
    with LOCK: rid = str(len(RUNS) + 1); RUNS[rid] = (proc, log.name)
    return {"run": rid, "command": " ".join(a if a else "''" for a in args[1:])}
def start_domain(body):
    """connect or check a site's domain through ship-site, streamed like a publish"""
    if not SHIP_SITE: return {"error": "ship-site is not installed on this computer"}
    pid, op, dom = str(body.get("id", "")), body.get("op"), str(body.get("domain", "")).strip().lower()
    if not pid or op not in ("connect", "check"): return {"error": "which project, and connect or check?"}
    if op == "connect" and not re.match(r"^([a-z0-9-]+\.)+[a-z]{2,}$", dom): return {"error": "that is not a domain; something like example.com or admin.example.com"}
    args = [SHIP_SITE, "--project", pid] + (["--domain", dom] if op == "connect" else ["--domain-check"]) + ["--yes"]
    log = tempfile.NamedTemporaryFile(prefix="devtools-run-", suffix=".log", delete=False)
    proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, env=dict(os.environ, TERM="dumb"))
    with LOCK: rid = str(len(RUNS) + 1); RUNS[rid] = (proc, log.name)
    return {"run": rid}
def people_edit(body):
    """add or remove a recipient, or set the subject, for a site (ship-site config, mail[id]) or an app (ship-apk config, projects[key])"""
    kind, pid, op = body.get("kind"), str(body.get("id", "")), body.get("op")
    role, email, name, subject = body.get("role", "to"), str(body.get("email", "")).strip(), str(body.get("name", "")).strip(), body.get("subject")
    if kind not in ("site", "app") or not pid or op not in ("add", "remove", "subject"): return {"error": "which project, and add, remove or subject?"}
    if role not in ("to", "cc", "bcc"): return {"error": "role is to, cc or bcc"}
    if op in ("add", "remove") and not re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", email): return {"error": "that is not an email address"}
    path = os.path.join(CONF, "ship-site" if kind == "site" else "ship-apk", "config.json")
    d = load("ship-site" if kind == "site" else "ship-apk", "config.json")
    if kind == "site":
        m = d.setdefault("mail", {}).setdefault(pid, {"to": [], "cc": [], "bcc": []})
    else:
        if pid not in d.get("projects", {}): return {"error": "no such app"}
        m = d["projects"][pid]
    if op == "subject": m["subject"] = str(subject or "")
    else:
        if op == "add":
            have = next((k for k in ("to", "cc", "bcc") if any(r.get("email", "").lower() == email.lower() for r in m.get(k, []))), None)
            if have: return {"error": "%s is already listed as %s" % (email, have.upper())}
            m.setdefault(role, []).append({"name": name or email.split("@")[0], "email": email})
        else: m[role] = [r for r in m.get(role, []) if r.get("email") != email]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    json.dump(d, open(path, "w"), indent=2); os.chmod(path, 0o600)
    return {"ok": True}
def cli_token(email):
    """the Firebase CLI's access token for that Google account; one harmless CLI call renews an expired one"""
    cs = os.path.join(os.path.expanduser("~"), ".config", "configstore", "firebase-tools.json")
    def read():
        try: c = json.load(open(cs))
        except Exception: return ""
        accts = [(c.get("user", {}).get("email"), c.get("tokens", {}))] + [(x.get("user", {}).get("email"), x.get("tokens", {})) for x in c.get("additionalAccounts", [])]
        tok = next((t for e, t in accts if e == email), {})
        return tok.get("access_token", "") if tok.get("expires_at", 0) / 1000 > time.time() + 60 else ""
    t = read()
    if not t: sh(["firebase", "projects:list", "--account", email]); t = read()
    return t
def fb_call(token, ep, method="GET", body=None):
    import urllib.request, urllib.error
    req = urllib.request.Request("https://firebasehosting.googleapis.com/v1beta1/" + ep, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r: raw = r.read(); return json.loads(raw) if raw else {}, None
    except urllib.error.HTTPError as e:
        try: msg = json.loads(e.read()).get("error", {}).get("message", str(e))
        except Exception: msg = str(e)
        return {}, (409 if e.code == 409 else 404 if e.code == 404 else msg)
    except Exception as e: return {}, "cannot reach Firebase: %s" % e
def dom_state(cd):
    if cd.get("hostState") != "HOST_ACTIVE": return "dns"
    return "live" if (cd.get("cert") or {}).get("state") == "CERT_ACTIVE" else "cert"
def records_of(cd, dom):
    base = ".".join(dom.split(".")[-2:])
    recs = [r for g in (cd.get("requiredDnsUpdates") or {}).get("desired", []) for r in g.get("records", [])]
    recs += [r for g in ((cd.get("cert") or {}).get("verification") or {}).get("dns", {}).get("desired", []) for r in g.get("records", [])]
    out = []
    for r in recs:
        if r.get("requiredAction") != "ADD": continue
        h = r["domainName"]; h = "@" if h == base else h[:-len(base) - 1] if h.endswith("." + base) else h
        out.append(dict(type=r["type"], host=h, value=r["rdata"], full=r["domainName"]))
    return out
def choose_folder(prompt):
    """a native folder picker; "" when cancelled"""
    try:
        if sys.platform == "darwin":
            r = subprocess.run(["osascript", "-e", 'tell application "System Events" to activate', "-e", 'POSIX path of (choose folder with prompt "%s")' % prompt], capture_output=True, text=True, timeout=600)
        else:
            r = subprocess.run(["zenity", "--file-selection", "--directory", "--title", prompt], capture_output=True, text=True, timeout=600)
        return r.stdout.strip().rstrip("/") if r.returncode == 0 else ""
    except Exception: return ""
def web_folder(f):
    return os.path.isfile(os.path.join(f, "package.json")) or any(os.path.isfile(os.path.join(f, d, "index.html")) for d in (".", "site", "public", "www", "docs", "static"))
def folder_says(f):
    """what the folder's own config names: Firebase project and site, Vercel project id"""
    rc, site, vid = "", "", ""
    try: rc = json.load(open(os.path.join(f, ".firebaserc"))).get("projects", {}).get("default", "")
    except Exception: pass
    try:
        h = json.load(open(os.path.join(f, "firebase.json"))).get("hosting", {})
        h = h[0] if isinstance(h, list) and h else h
        site = h.get("site", "") if isinstance(h, dict) else ""
    except Exception: pass
    try: vid = json.load(open(os.path.join(f, ".vercel", "project.json"))).get("projectId", "")
    except Exception: pass
    return rc, site, vid
def link_folder(body):
    """pick a folder in the Finder and link it to a project: the given one, or the one the folder's config names"""
    pid, op = str(body.get("id", "")), body.get("op", "pick")
    d = load("ship-site", "config.json"); path = os.path.join(CONF, "ship-site", "config.json")
    row = next((c for c in d.get("cache", []) if c["id"] == pid), None) if pid else None
    if pid and not row: return {"error": "no such project"}
    if op == "unlink":
        for f in [f for f, pr in d.get("projects", {}).items() if pr.get("id") == pid]: d["projects"].pop(f, None)
        json.dump(d, open(path, "w"), indent=2); os.chmod(path, 0o600); return {"ok": True}
    f = choose_folder("The folder of " + (row["name"] if row else "the web project") + " (package.json or index.html)")
    if not f: return {"cancelled": True}
    if not web_folder(f): return {"error": "no package.json and no index.html in " + f.replace(os.path.expanduser("~"), "~")}
    if not row:
        rc, site, vid = folder_says(f)
        hits = [c for c in d.get("cache", []) if (vid and c["id"] == vid) or (rc and c["id"].startswith(rc + "/") and (not site or c["id"].endswith("/" + site)))]
        if len(hits) != 1:
            what = " · ".join(x for x in ("Firebase " + rc if rc else "", "site " + site if site else "", "Vercel " + vid if vid else "") if x)
            return {"error": ("this folder's config names %s, which is not in your list" % what) if what else "no .firebaserc or .vercel/project.json in that folder; publish it once from the terminal, which creates the project"}
        row = hits[0]
    d.setdefault("projects", {})[f] = dict(d["projects"].get(f, {}), account=row["account"], id=row["id"], name=row["name"], host=row.get("host", "vercel"))
    json.dump(d, open(path, "w"), indent=2); os.chmod(path, 0o600)
    return {"ok": True, "id": row["id"], "folder": f}
def label_edit(body):
    pid, label = str(body.get("id", "")), str(body.get("label", "")).strip()[:40]
    d = load("ship-site", "config.json"); path = os.path.join(CONF, "ship-site", "config.json")
    if not any(c["id"] == pid for c in d.get("cache", [])): return {"error": "no such project"}
