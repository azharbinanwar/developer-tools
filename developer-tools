#!/usr/bin/env bash
# developer-tools: the hub. One menu to run, install, update or remove every tool.
#
#   bash <(curl -fsSL https://raw.githubusercontent.com/azharbinanwar/developer-tools/main/developer-tools)
#
# Each tool is also a standalone command (ship-apk, ship-site). Running one from
# here uses the installed copy if there is one, otherwise the latest release
# straight from GitHub, so the hub works with nothing installed.
#
# License: MIT.

set -uo pipefail

if [ -t 2 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  B=$(tput bold); D=$(tput dim); R=$(tput sgr0); A=$(tput setaf 6); G=$(tput setaf 2); Y=$(tput setaf 3); E=$(tput setaf 1)
else B=; D=; R=; A=; G=; Y=; E=; fi
VERSION="1.0.0"
banner(){ printf "\n  ${A}${B}◆  %s${R}  ${D}%s${R}\n" "$1" "${2:-}" >&2; }
step(){ printf "\n  ${A}${B}▸${R} ${B}%s${R}\n" "$1" >&2; }
ok(){ printf "     ${G}✓${R} %s\n" "$1" >&2; }
die(){ printf "\n  ${E}${B}✗ %s${R}\n" "$1" >&2; exit 1; }

BASE="${DEVTOOLS_BASE:-https://github.com/azharbinanwar/developer-tools/releases/latest/download}"   # DEVTOOLS_BASE=file:///dir to test locally
BIN="/usr/local/bin"
TOOLS=(ship-apk ship-site)
NOTES=("build a Flutter APK, upload it to appho.st, mail the link"
       "build a Vite site, publish dist/ to Vercel, copy the link")

menu_pick(){ # $1 title, rest items -> echoes chosen index. ↑↓ or j/k move, Enter picks, q quits
  local title="$1"; shift
  local items=("$@") n=$# sel=0 k rest i saved
  saved="$(stty -g 2>/dev/null || true)"
  [ -n "$saved" ] && { stty -echo -icanon 2>/dev/null; trap 'stty "$saved" 2>/dev/null; exit 130' INT; }
  printf "     ${D}%s  · ↑↓ move · Enter picks · q quits${R}\n" "$title" >&2
  for ((i=0;i<n;i++)); do printf '\n' >&2; done
  while :; do
    printf "\033[%dA" "$n" >&2
    for ((i=0;i<n;i++)); do
      [ "$i" -eq "$sel" ] && printf "\r\033[K     ${A}❯ %s${R}\n" "${items[$i]}" >&2 \
                          || printf "\r\033[K       ${D}%s${R}\n" "${items[$i]}" >&2
    done
    IFS= read -rsn1 k 2>/dev/null || break
    case "$k" in
      '')    break ;;
      $'\e') IFS= read -rsn2 rest 2>/dev/null || rest=""
             case "$rest" in "[A") sel=$(((sel-1+n)%n)) ;; "[B") sel=$(((sel+1)%n)) ;; esac ;;
      k|K)   sel=$(((sel-1+n)%n)) ;;
      j|J)   sel=$(((sel+1)%n)) ;;
      q|Q)   [ -n "$saved" ] && stty "$saved" 2>/dev/null; printf "\n" >&2; exit 0 ;;
    esac
  done
  [ -n "$saved" ] && { trap - INT; stty "$saved" 2>/dev/null; }
  printf '%s' "$sel"
}

status(){ # $1 tool -> "installed 1.0.0" or "not installed"
  command -v "$1" >/dev/null 2>&1 && printf 'installed %s' "$("$1" --version 2>/dev/null | awk '{print $2}')" || printf 'not installed'
}

install_tool(){ # $1 tool -> downloads the latest release into BIN
  local t="$1" tmp
  tmp="$(mktemp -t "$t")"
  curl -fsSL "$BASE/$t" -o "$tmp" || { rm -f "$tmp"; die "could not download $t — is there a release yet?"; }
  bash -n "$tmp" || { rm -f "$tmp"; die "$t downloaded broken, not installing it"; }
  sudo mkdir -p "$BIN" && sudo install -m 755 "$tmp" "$BIN/$t" || { rm -f "$tmp"; die "could not write $BIN/$t"; }
  rm -f "$tmp"
  ok "$t $("$BIN/$t" --version 2>/dev/null | awk '{print $2}') → $BIN/$t"
}

run_tool(){ # $1 tool -> installed copy if any, otherwise the latest release from GitHub
  local t="$1"
  printf "\n" >&2
  if command -v "$t" >/dev/null 2>&1; then exec "$t"; fi
  exec bash <(curl -fsSL "$BASE/$t")
}

tool_menu(){ # $1 index
  local i="$1" t="${TOOLS[$1]}" c
  while :; do
    step "$t  ${D}$(status "$t")${R}"
    printf "     ${D}%s${R}\n" "${NOTES[$i]}" >&2
    if command -v "$t" >/dev/null 2>&1; then
      c="$(menu_pick "What to do" "run it" "update to the latest release" "remove it" "← back")"
      case "$c" in
        0) run_tool "$t" ;;
        1) install_tool "$t" ;;
        2) sudo rm -f "$BIN/$t" && ok "removed $t  ${D}(settings in ~/.config/$t are kept)${R}" ;;
        3) return ;;
      esac
    else
      c="$(menu_pick "What to do" "run it without installing" "install it" "← back")"
      case "$c" in
        0) run_tool "$t" ;;
        1) install_tool "$t" ;;
        2) return ;;
      esac
    fi
  done
}

main(){
  case "${1:-}" in
    --version|-V) echo "developer-tools $VERSION"; exit 0 ;;
    -h|--help)
      printf "\n  ${B}developer-tools${R} ${D}%s${R}\n\n" "$VERSION"
      printf "    ${A}developer-tools${R}              menu: run, install, update or remove any tool\n"
      printf "    ${A}developer-tools install${R}      install or update every tool, no questions\n"
      printf "    ${A}developer-tools <tool>${R}       run one tool (ship-apk, ship-site)\n\n"
      printf "  ${D}Tools install to %s and keep their settings in ~/.config/<tool>/${R}\n\n" "$BIN"
      exit 0 ;;
    install)
      banner "developer-tools $VERSION" "installing everything"
      for t in "${TOOLS[@]}"; do install_tool "$t"; done
      case ":$PATH:" in *":$BIN:"*) ;; *) printf "     ${Y}!${R} add %s to your PATH to run them by name\n" "$BIN" >&2 ;; esac
      printf "\n" >&2; exit 0 ;;
    "") ;;
    *) for t in "${TOOLS[@]}"; do [ "$1" = "$t" ] && { shift; run_tool "$t" "$@"; }; done
       die "no tool called “$1” — try: developer-tools --help" ;;
  esac
  [ -t 0 ] || die "developer-tools needs a terminal — run it, do not pipe into it"

  banner "developer-tools $VERSION" "pick a tool"
  local items=() i c
  while :; do
    items=()
    for ((i=0;i<${#TOOLS[@]};i++)); do items+=("$(printf '%-11s %-56s %s' "${TOOLS[$i]}" "${NOTES[$i]}" "$(status "${TOOLS[$i]}")")"); done
    items+=("install or update everything" "quit")
    printf "\n" >&2
    c="$(menu_pick "Tools" "${items[@]}")"
    if   [ "$c" -eq ${#TOOLS[@]} ]; then for t in "${TOOLS[@]}"; do install_tool "$t"; done
    elif [ "$c" -eq $(( ${#TOOLS[@]} + 1 )) ]; then printf "\n" >&2; exit 0
    else tool_menu "$c"; fi
  done
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
